<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Colours and brushes live in Palettes/*.xaml, which ThemeManager swaps at runtime; reference them with DynamicResource. -->

  <!-- Typography -->
  <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
  <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <sys:Double x:Key="FontSizeCaption">11</sys:Double>
  <sys:Double x:Key="FontSizeSmall">12</sys:Double>
  <sys:Double x:Key="FontSizeBody">13</sys:Double>
  <sys:Double x:Key="FontSizeSection">14</sys:Double>
  <sys:Double x:Key="FontSizePageTitle">26</sys:Double>
  <sys:Double x:Key="FontSizeKpi">30</sys:Double>

  <!-- Shape and spacing -->
  <CornerRadius x:Key="RadiusCard">12</CornerRadius>
  <CornerRadius x:Key="RadiusControl">8</CornerRadius>
  <CornerRadius x:Key="RadiusPill">10</CornerRadius>
  <Thickness x:Key="CardPadding">20</Thickness>
  <Thickness x:Key="PageMargin">28,6,28,24</Thickness>
  <sys:Double x:Key="TitleBarHeight">48</sys:Double>
</ResourceDictionary>
