<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Purple palette: near-black with layered violet and fuchsia aurora glows, glassy cards and a violet-to-pink accent. Keys match Palettes/Dark.xaml. -->
  <sys:Boolean x:Key="IsDarkTheme">True</sys:Boolean>

  <Color x:Key="BackgroundColor">#06050A</Color>
  <Color x:Key="SidebarColor">#040308</Color>
  <Color x:Key="SurfaceColor">#15111F</Color>
  <Color x:Key="SurfaceRaisedColor">#1C1729</Color>
  <Color x:Key="InputColor">#08060E</Color>
  <Color x:Key="AccentColor">#A855F7</Color>
  <Color x:Key="AccentAltColor">#EC4899</Color>
  <Color x:Key="TextColor">#F3EEFF</Color>
  <Color x:Key="TextMutedColor">#A59CC0</Color>
  <Color x:Key="TextSubtleColor">#6E6585</Color>
  <Color x:Key="SuccessColor">#34D399</Color>
  <Color x:Key="WarningColor">#FBBF24</Color>
  <Color x:Key="DangerColor">#FB7185</Color>
  <Color x:Key="InfoColor">#67E8F9</Color>

  <!-- Aurora: black, a violet glow top right, a fuchsia glow bottom left and a faint indigo haze. -->
  <DrawingBrush x:Key="BackgroundBrush">
    <DrawingBrush.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#06050A" Geometry="M0,0 H1 V1 H0 Z" />
        <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z">
          <GeometryDrawing.Brush>
            <RadialGradientBrush Center="0.92,0" GradientOrigin="0.92,0" RadiusX="0.75" RadiusY="0.9">
              <GradientStop Offset="0" Color="#995B21B6" />
              <GradientStop Offset="0.5" Color="#262E1065" />
              <GradientStop Offset="1" Color="#002E1065" />
            </RadialGradientBrush>
          </GeometryDrawing.Brush>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z">
          <GeometryDrawing.Brush>
            <RadialGradientBrush Center="0.05,1.05" GradientOrigin="0.05,1.05" RadiusX="0.6" RadiusY="0.7">
              <GradientStop Offset="0" Color="#59A21CAF" />
              <GradientStop Offset="1" Color="#00A21CAF" />
            </RadialGradientBrush>
          </GeometryDrawing.Brush>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z">
          <GeometryDrawing.Brush>
            <RadialGradientBrush Center="0.4,0.45" GradientOrigin="0.4,0.45" RadiusX="0.5" RadiusY="0.5">
              <GradientStop Offset="0" Color="#1F4338CA" />
              <GradientStop Offset="1" Color="#004338CA" />
            </RadialGradientBrush>
          </GeometryDrawing.Brush>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingBrush.Drawing>
  </DrawingBrush>
  <DrawingBrush x:Key="BackgroundMicaBrush">
    <DrawingBrush.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#E606050A" Geometry="M0,0 H1 V1 H0 Z" />
        <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z">
          <GeometryDrawing.Brush>
            <RadialGradientBrush Center="0.92,0" GradientOrigin="0.92,0" RadiusX="0.75" RadiusY="0.9">
              <GradientStop Offset="0" Color="#995B21B6" />
              <GradientStop Offset="0.5" Color="#262E1065" />
              <GradientStop Offset="1" Color="#002E1065" />
            </RadialGradientBrush>
          </GeometryDrawing.Brush>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z">
          <GeometryDrawing.Brush>
            <RadialGradientBrush Center="0.05,1.05" GradientOrigin="0.05,1.05" RadiusX="0.6" RadiusY="0.7">
              <GradientStop Offset="0" Color="#59A21CAF" />
              <GradientStop Offset="1" Color="#00A21CAF" />
            </RadialGradientBrush>
          </GeometryDrawing.Brush>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingBrush.Drawing>
  </DrawingBrush>
  <!-- Black, lit by a violet glow under the logo. -->
  <DrawingBrush x:Key="SidebarBrush">
    <DrawingBrush.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#040308" Geometry="M0,0 H1 V1 H0 Z" />
        <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z">
          <GeometryDrawing.Brush>
            <RadialGradientBrush Center="0.15,0" GradientOrigin="0.15,0" RadiusX="1.1" RadiusY="0.45">
              <GradientStop Offset="0" Color="#734C1D95" />
              <GradientStop Offset="1" Color="#004C1D95" />
            </RadialGradientBrush>
          </GeometryDrawing.Brush>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingBrush.Drawing>
  </DrawingBrush>
  <DrawingBrush x:Key="SidebarMicaBrush">
    <DrawingBrush.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#C2040308" Geometry="M0,0 H1 V1 H0 Z" />
        <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z">
          <GeometryDrawing.Brush>
            <RadialGradientBrush Center="0.15,0" GradientOrigin="0.15,0" RadiusX="1.1" RadiusY="0.45">
              <GradientStop Offset="0" Color="#734C1D95" />
              <GradientStop Offset="1" Color="#004C1D95" />
            </RadialGradientBrush>
          </GeometryDrawing.Brush>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingBrush.Drawing>
  </DrawingBrush>
  <!-- Glass: translucent, a touch lighter at the top, so the aurora shows through. -->
  <LinearGradientBrush x:Key="SurfaceBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#C71E1730" />
    <GradientStop Offset="1" Color="#B80E0B18" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="SurfaceRaisedBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#F5231B38" />
    <GradientStop Offset="1" Color="#F5171225" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="InputBrush" Color="#B305040A" />
  <!-- A lit top edge that fades down the sides. -->
  <LinearGradientBrush x:Key="BorderBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#47C4B5FD" />
    <GradientStop Offset="1" Color="#1A8B5CF6" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="BorderStrongBrush" Color="#47C084FC" />
  <SolidColorBrush x:Key="DividerBrush" Color="#14C4B5FD" />
  <SolidColorBrush x:Key="FillSubtleBrush" Color="#0DC4B5FD" />
  <SolidColorBrush x:Key="FillBrush" Color="#24A855F7" />
  <SolidColorBrush x:Key="FillStrongBrush" Color="#33A855F7" />
  <SolidColorBrush x:Key="HoverBrush" Color="#17A855F7" />
  <SolidColorBrush x:Key="PressBrush" Color="#33000000" />
  <SolidColorBrush x:Key="ScrollThumbBrush" Color="#4DC084FC" />
  <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#80C084FC" />
  <SolidColorBrush x:Key="ScrollThumbPressedBrush" Color="#B3C084FC" />

  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
  <SolidColorBrush x:Key="TextSubtleBrush" Color="{StaticResource TextSubtleColor}" />
  <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

  <SolidColorBrush x:Key="AccentBrush" Color="#C084FC" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#D8B4FE" />
  <SolidColorBrush x:Key="AccentSubtleBrush" Color="#33A855F7" />
  <SolidColorBrush x:Key="SelectionBrush" Color="#2EA855F7" />
  <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Offset="0" Color="#7C3AED" />
    <GradientStop Offset="0.5" Color="{StaticResource AccentColor}" />
    <GradientStop Offset="1" Color="{StaticResource AccentAltColor}" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="AccentGradientHorizontalBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Offset="0" Color="#8B5CF6" />
    <GradientStop Offset="0.5" Color="#C084FC" />
    <GradientStop Offset="1" Color="#F472B6" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="ShimmerBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Offset="0" Color="#00A855F7" />
    <GradientStop Offset="0.5" Color="#FFF0ABFC" />
    <GradientStop Offset="1" Color="#00EC4899" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="NeutralBrush" Color="{StaticResource TextMutedColor}" />
  <SolidColorBrush x:Key="NeutralSubtleBrush" Color="#1AA59CC0" />
  <SolidColorBrush x:Key="NeutralBorderBrush" Color="#33A59CC0" />
  <SolidColorBrush x:Key="AccentBorderBrush" Color="#73C084FC" />
  <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
  <SolidColorBrush x:Key="InfoSubtleBrush" Color="#1F67E8F9" />
  <SolidColorBrush x:Key="InfoBorderBrush" Color="#5967E8F9" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
  <SolidColorBrush x:Key="SuccessSubtleBrush" Color="#1F34D399" />
  <SolidColorBrush x:Key="SuccessBorderBrush" Color="#5934D399" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
  <SolidColorBrush x:Key="WarningSubtleBrush" Color="#1FFBBF24" />
  <SolidColorBrush x:Key="WarningBorderBrush" Color="#59FBBF24" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="DangerSubtleBrush" Color="#1FFB7185" />
  <SolidColorBrush x:Key="DangerBorderBrush" Color="#59FB7185" />
  <SolidColorBrush x:Key="CaptionCloseBrush" Color="#C42B1C" />
</ResourceDictionary>