<UserControl x:Class="QuoteSnap.Desktop.Views.NewRequestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:QuoteSnap.Desktop.Controls"
             xmlns:views="clr-namespace:QuoteSnap.Desktop.Views"
             xmlns:vm="clr-namespace:QuoteSnap.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:NewRequestViewModel}">
  <UserControl.Resources>
    <Style x:Key="Stat" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource FillSubtleBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="Margin" Value="0,0,10,0" />
    </Style>
    <Style x:Key="StatValue" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,2,0,0" />
      <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>
  </UserControl.Resources>

  <Grid Margin="{StaticResource PageMargin}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="220" />
    </Grid.RowDefinitions>

    <StackPanel Margin="0,0,0,22">
      <TextBlock Text="New request" Style="{StaticResource Text.PageTitle}" />
      <TextBlock Text="Paste Fyers symbols, one per line or separated by commas. QuoteSnap fetches them in batches of 50 and streams the results."
                 Style="{StaticResource Text.PageSubtitle}" />
    </StackPanel>

    <Border Grid.Row="1" Style="{StaticResource Banner}" Tag="{Binding MessageLevel}" Margin="0,0,0,16"
            Visibility="{Binding Message, Converter={StaticResource VisibleWhenNull}, ConverterParameter=invert}">
      <DockPanel>
        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE946;" FontSize="14" Margin="0,1,10,0" VerticalAlignment="Top"
                   Foreground="{Binding MessageLevel, Converter={StaticResource ToneBrush}}" />
        <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Body}" />
      </DockPanel>
    </Border>

    <Grid Grid.Row="2" Height="316" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="7*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="5*" MinWidth="380" />
      </Grid.ColumnDefinitions>

      <!-- Symbols input -->
      <Border Style="{StaticResource Card}" Padding="18,14,18,16">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="2,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Style="{StaticResource Button.Ghost}" ui:Ui.Icon="&#xE8E5;" Content="Load file" Command="{Binding LoadFileCommand}" />
              <Button Style="{StaticResource Button.Ghost}" ui:Ui.Icon="&#xE74D;" Content="Clear" Command="{Binding ClearCommand}" />
            </StackPanel>
            <TextBlock Text="Symbols" Style="{StaticResource Text.Section}" />
          </DockPanel>

          <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Grid DockPanel.Dock="Right">
              <Button Style="{StaticResource Button.Primary}" ui:Ui.Icon="&#xE945;" Content="Fetch quotes" Padding="18,0"
                      Command="{Binding SubmitCommand}" IsDefault="True"
                      Visibility="{Binding SubmitCommand.IsRunning, Converter={StaticResource InverseBoolToVisibility}}" />
              <Button ui:Ui.Icon="&#xE71A;" Content="Stop watching" Command="{Binding SubmitCancelCommand}"
                      ToolTip="Stops following progress here; the request keeps running on the server."
                      Visibility="{Binding SubmitCommand.IsRunning, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border Style="{StaticResource Chip}" Margin="0" Padding="8,2">
                <TextBlock Text="{Binding SymbolSummary}" FontSize="{StaticResource FontSizeSmall}" Typography.NumeralAlignment="Tabular" />
              </Border>
              <TextBlock Text="Drop a .txt or .csv file onto the box to load it" Style="{StaticResource Text.Muted}"
                         Foreground="{StaticResource TextSubtleBrush}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DockPanel>

          <TextBox Style="{StaticResource TextBox.Editor}" Text="{Binding SymbolsText, UpdateSourceTrigger=PropertyChanged}"
                   ui:Ui.FileDropCommand="{Binding DropTextCommand}" AutomationProperties.Name="Symbols"
                   ui:Ui.Placeholder="NSE:SBIN-EQ&#10;NSE:RELIANCE-EQ&#10;NSE:NIFTY50-INDEX&#10;BSE:TCS-A" />
        </DockPanel>
      </Border>

      <!-- Progress -->
      <Border Grid.Column="2" Style="{StaticResource Card}">
        <Grid>
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                      Visibility="{Binding HasRequest, Converter={StaticResource InverseBoolToVisibility}}">
            <ContentControl Style="{StaticResource IconBadge}" Tag="{x:Static ui:Tone.Accent}" Content="&#xE945;" Width="48" Height="48" HorizontalAlignment="Center" />
            <TextBlock Text="Ready when you are" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSection}" HorizontalAlignment="Center" Margin="0,14,0,4" />
            <TextBlock Text="Progress, counts and timing appear here once you fetch quotes." Style="{StaticResource Text.Muted}"
                       TextAlignment="Center" MaxWidth="260" />
          </StackPanel>

          <DockPanel Visibility="{Binding HasRequest, Converter={StaticResource BoolToVisibility}}">
            <DockPanel DockPanel.Dock="Top">
              <ui:StatusPill DockPanel.Dock="Right" Style="{StaticResource StatusPill.Large}"
                             Text="{Binding StatusLabel}" Tone="{Binding StatusTone, Converter={StaticResource Tone}}" />
              <TextBlock Text="Progress" Style="{StaticResource Text.Section}" />
            </DockPanel>

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,18,0,10">
              <TextBlock Text="{Binding PercentText}" Style="{StaticResource Text.Kpi}" FontSize="34" />
              <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Text.Muted}" VerticalAlignment="Bottom" Margin="12,0,0,8" />
            </StackPanel>
            <ProgressBar DockPanel.Dock="Top" Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" IsIndeterminate="{Binding IsIndeterminate}" />

            <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="0,18,-10,0">
              <Border Style="{StaticResource Stat}">
                <StackPanel>
                  <TextBlock Text="TOTAL" Style="{StaticResource Text.Label}" />
                  <TextBlock Text="{Binding Total, StringFormat=N0}" Style="{StaticResource StatValue}" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Stat}">
                <StackPanel>
                  <TextBlock Text="OK" Style="{StaticResource Text.Label}" />
                  <TextBlock Text="{Binding Results.Ok, StringFormat=N0}" Style="{StaticResource StatValue}" Foreground="{StaticResource SuccessBrush}" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Stat}">
                <StackPanel>
                  <TextBlock Text="FAILED" Style="{StaticResource Text.Label}" />
                  <TextBlock Text="{Binding Results.Errors, StringFormat=N0}" Style="{StaticResource StatValue}" Foreground="{StaticResource DangerBrush}" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Stat}">
                <StackPanel>
                  <TextBlock Text="INVALID" Style="{StaticResource Text.Label}" />
                  <TextBlock Text="{Binding Results.Invalid, StringFormat=N0}" Style="{StaticResource StatValue}" Foreground="{StaticResource WarningBrush}" />
                </StackPanel>
              </Border>
            </UniformGrid>

            <TextBlock DockPanel.Dock="Top" Text="{Binding InvalidSymbolsText}" Style="{StaticResource Text.Message}" Margin="0,12,0,0"
                       Foreground="{StaticResource WarningBrush}" MaxHeight="36" TextTrimming="CharacterEllipsis" ToolTip="{Binding InvalidSymbolsText}" />

            <DockPanel VerticalAlignment="Bottom">
              <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" ui:Ui.Icon="&#xE8C8;" ToolTip="Copy request ID"
                      AutomationProperties.Name="Copy request ID" Command="{Binding CopyRequestIdCommand}"
                      Visibility="{Binding RequestId, Converter={StaticResource VisibleWhenNull}, ConverterParameter=invert}" />
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE916;" FontSize="12" Foreground="{StaticResource TextSubtleBrush}" />
                <TextBlock Text="{Binding ElapsedText, TargetNullValue=—}" Style="{StaticResource Text.Muted}" Margin="6,0,16,0" Typography.NumeralAlignment="Tabular" />
                <TextBlock Text="ID" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Foreground="{StaticResource TextSubtleBrush}" />
                <TextBlock Text="{Binding ShortRequestId, TargetNullValue=—}" ToolTip="{Binding RequestId}" Style="{StaticResource Text.Mono}"
                           Foreground="{StaticResource TextMutedBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </DockPanel>
          </DockPanel>
        </Grid>
      </Border>
    </Grid>

    <views:QuoteResultsPanel Grid.Row="3" DataContext="{Binding Results}" />
  </Grid>
</UserControl>
