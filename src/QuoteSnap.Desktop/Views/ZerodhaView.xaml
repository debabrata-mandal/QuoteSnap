<UserControl x:Class="QuoteSnap.Desktop.Views.ZerodhaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:QuoteSnap.Desktop.Controls"
             xmlns:vm="clr-namespace:QuoteSnap.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ZerodhaViewModel}">
  <UserControl.Resources>
    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
      <Setter Property="Margin" Value="2,0,0,6" />
    </Style>
    <Style x:Key="FieldHint" TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
      <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
      <Setter Property="Margin" Value="2,5,0,0" />
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="{StaticResource PageMargin}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Margin="0,0,0,22">
        <TextBlock Text="Zerodha" Style="{StaticResource Text.PageTitle}" />
        <TextBlock Text="Makes My funds match your Zerodha (Coin) mutual fund holdings: held funds are added with their units, and funds you no longer hold are removed. Every sync asks you to log in to Zerodha; QuoteSnap logs out again as soon as it has read the holdings and keeps no Zerodha login."
                   Style="{StaticResource Text.PageSubtitle}" />
      </StackPanel>

      <Border Grid.Row="1" Style="{StaticResource Banner}" Tag="{x:Static vm:StatusLevel.Warning}" Margin="0,0,0,16"
              Visibility="{Binding HasAdminKey, Converter={StaticResource InverseBoolToVisibility}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Open Settings" Margin="12,0,0,0" VerticalAlignment="Center" Command="{Binding OpenSettingsCommand}" />
          <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE7BA;" FontSize="14" Margin="0,1,10,0" VerticalAlignment="Top"
                     Foreground="{DynamicResource WarningBrush}" />
          <TextBlock Style="{StaticResource Text.Body}" VerticalAlignment="Center"
                     Text="Syncing needs the admin API key, and none is set. Add Auth__AdminApiKey to the repository's .env, or enter the key in Settings." />
        </DockPanel>
      </Border>

      <Border Grid.Row="2" Style="{StaticResource Card}" Padding="22,18,22,20" VerticalAlignment="Top" HorizontalAlignment="Left" MinWidth="460" MaxWidth="900">
        <StackPanel>
          <DockPanel Margin="0,0,0,18">
            <ContentControl Style="{StaticResource IconBadge}" Tag="{x:Static vm:StatusLevel.Unknown}" Content="&#xE895;" Width="32" Height="32" />
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="Sync mutual funds" Style="{StaticResource Text.Section}" />
              <TextBlock Text="Opens the Zerodha login page in your browser. After you log in, Zerodha sends you back to this app, and QuoteSnap reads the holdings once."
                         Style="{StaticResource Text.Muted}" Margin="0,2,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </DockPanel>

          <Grid IsEnabled="{Binding CanEditDetails}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="16" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="16" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
              <TextBlock Text="API KEY" Style="{StaticResource FieldLabel}" />
              <TextBox Style="{StaticResource TextBox.Mono}" Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Kite Connect API key" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="API SECRET" Style="{StaticResource FieldLabel}" />
              <PasswordBox x:Name="ApiSecretBox" PasswordChanged="OnPasswordChanged" AutomationProperties.Name="Kite Connect API secret" />
              <TextBlock Text="Sent with each sync and never stored by QuoteSnap." Style="{StaticResource FieldHint}" />
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.ColumnSpan="3">
              <TextBlock Text="REDIRECT URL" Style="{StaticResource FieldLabel}" />
              <TextBox Style="{StaticResource TextBox.Mono}" Text="{Binding RedirectUri, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Redirect URL" />
              <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap">
                <Run Text="Must match the Redirect URL of your Kite Connect app on developers.kite.trade." />
                <LineBreak />
                <Run Text="{Binding DetailsSource, Mode=OneWay}" Foreground="{DynamicResource TextSubtleBrush}" />
              </TextBlock>
            </StackPanel>
          </Grid>

          <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,18,0,18" />

          <Button Style="{StaticResource Button.Primary}" ui:Ui.Icon="&#xE895;" Content="Log in and sync" Padding="20,0" HorizontalAlignment="Left"
                  Command="{Binding SyncCommand}" AutomationProperties.Name="Log in to Zerodha and sync mutual funds"
                  Visibility="{Binding IsSyncing, Converter={StaticResource InverseBoolToVisibility}}" />

          <!-- While syncing: what's happening, the page link, and Cancel. -->
          <Border Style="{StaticResource Banner}" Tag="{x:Static vm:StatusLevel.Busy}" Padding="16,14"
                  Visibility="{Binding IsSyncing, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="Cancel" Margin="12,0,0,0" VerticalAlignment="Top" Command="{Binding CancelCommand}" />
                <TextBlock Text="{Binding Step}" Style="{StaticResource Text.Body}" />
              </DockPanel>
              <ProgressBar IsIndeterminate="True" Height="3" Margin="0,12,0,0" />
              <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Visibility="{Binding HasLoginUrl, Converter={StaticResource BoolToVisibility}}">
                <Button Style="{StaticResource Button.Ghost}" ui:Ui.Icon="&#xE8A7;" Content="Open the page again" Command="{Binding OpenLoginPageCommand}" />
                <Button Style="{StaticResource Button.Ghost}" ui:Ui.Icon="&#xE8C8;" Content="Copy link" Margin="6,0,0,0" Command="{Binding CopyLoginUrlCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- How the last sync went. -->
          <Border Style="{StaticResource Banner}" Tag="{Binding MessageLevel}" Padding="14,12" Margin="0,14,0,0"
                  Visibility="{Binding Message, Converter={StaticResource VisibleWhenNull}, ConverterParameter=invert}">
            <DockPanel>
              <TextBlock FontSize="16" Margin="0,1,12,0" VerticalAlignment="Top" Foreground="{Binding MessageLevel, Converter={StaticResource ToneBrush}}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Icon}">
                    <Setter Property="Text" Value="&#xE946;" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding MessageLevel}" Value="{x:Static vm:StatusLevel.Good}">
                        <Setter Property="Text" Value="&#xE930;" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <StackPanel>
                <TextBlock Text="{Binding MessageTitle}" FontWeight="SemiBold" Foreground="{Binding MessageLevel, Converter={StaticResource ToneBrush}}"
                           Visibility="{Binding MessageTitle, Converter={StaticResource VisibleWhenNull}, ConverterParameter=invert}" Margin="0,0,0,2" />
                <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Body}" />
              </StackPanel>
            </DockPanel>
          </Border>

          <!-- What changed. -->
          <ItemsControl ItemsSource="{Binding Changes}" Margin="0,14,0,0" Visibility="{Binding HasChanges, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:ZerodhaSyncRow}">
                <DockPanel Margin="0,0,0,8">
                  <TextBlock DockPanel.Dock="Left" Width="100" Text="{Binding Change}" FontWeight="SemiBold" />
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Style="{StaticResource Text.Muted}" Margin="12,0,0,0" Typography.NumeralAlignment="Tabular" />
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
