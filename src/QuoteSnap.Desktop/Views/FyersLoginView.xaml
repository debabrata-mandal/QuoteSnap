<UserControl x:Class="QuoteSnap.Desktop.Views.FyersLoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:QuoteSnap.Desktop.Controls"
             xmlns:vm="clr-namespace:QuoteSnap.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:FyersLoginViewModel}">
  <UserControl.Resources>
    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
      <Setter Property="Margin" Value="2,0,0,6" />
    </Style>
    <Style x:Key="FieldHint" TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
      <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
      <Setter Property="Margin" Value="2,5,0,0" />
    </Style>
    <Style x:Key="Fact" TargetType="DockPanel">
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="{StaticResource PageMargin}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Margin="0,0,0,22">
        <TextBlock Text="Fyers login" Style="{StaticResource Text.PageTitle}" />
        <TextBlock Text="Quotes come from Fyers through a login that lasts about 15 days; QuoteSnap renews its token every day in between. Log in here when it runs out. This does what the quotesnap-login tool does."
                   Style="{StaticResource Text.PageSubtitle}" />
      </StackPanel>

      <Border Grid.Row="1" Style="{StaticResource Banner}" Tag="{x:Static vm:StatusLevel.Warning}" Margin="0,0,0,16"
              Visibility="{Binding HasAdminKey, Converter={StaticResource InverseBoolToVisibility}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Open Settings" Margin="12,0,0,0" VerticalAlignment="Center" Command="{Binding OpenSettingsCommand}" />
          <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE7BA;" FontSize="14" Margin="0,1,10,0" VerticalAlignment="Top"
                     Foreground="{DynamicResource WarningBrush}" />
          <TextBlock Style="{StaticResource Text.Body}" VerticalAlignment="Center"
                     Text="Logging in needs the admin API key, and none is set. Add Auth__AdminApiKey to the repository's .env, or enter the key in Settings." />
        </DockPanel>
      </Border>

      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="460" MaxWidth="760" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <!-- Log in -->
        <Border Style="{StaticResource Card}" Padding="22,18,22,20" VerticalAlignment="Top">
          <StackPanel>
            <DockPanel Margin="0,0,0,18">
              <ContentControl Style="{StaticResource IconBadge}" Tag="{x:Static vm:StatusLevel.Unknown}" Content="&#xE8D7;" Width="32" Height="32" />
              <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Log in" Style="{StaticResource Text.Section}" />
                <TextBlock Text="Opens the Fyers login page in your browser. After you log in, Fyers sends you back to this app, which hands the login to QuoteSnap."
                           Style="{StaticResource Text.Muted}" Margin="0,2,0,0" />
              </StackPanel>
            </DockPanel>

            <Grid IsEnabled="{Binding CanEditDetails}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <StackPanel>
                <TextBlock Text="APP ID" Style="{StaticResource FieldLabel}" />
                <TextBox Style="{StaticResource TextBox.Mono}" Text="{Binding AppId, UpdateSourceTrigger=PropertyChanged}"
                         ui:Ui.Placeholder="XXXXXXXXXX-100" AutomationProperties.Name="Fyers App ID" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="SECRET ID" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="SecretIdBox" PasswordChanged="OnPasswordChanged" AutomationProperties.Name="Fyers Secret ID" />
              </StackPanel>
              <StackPanel Grid.Row="2">
                <TextBlock Text="PIN" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="PinBox" PasswordChanged="OnPasswordChanged" AutomationProperties.Name="Fyers PIN" />
                <TextBlock Text="Your Fyers account PIN; the service needs it to renew the token." Style="{StaticResource FieldHint}" />
              </StackPanel>
              <StackPanel Grid.Row="2" Grid.Column="2">
                <TextBlock Text="REDIRECT URI" Style="{StaticResource FieldLabel}" />
                <TextBox Style="{StaticResource TextBox.Mono}" Text="{Binding RedirectUri, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Redirect URI" />
                <TextBlock Text="Must match the Redirect URI of your app on myapi.fyers.in." Style="{StaticResource FieldHint}" />
              </StackPanel>

              <DockPanel Grid.Row="4" Grid.ColumnSpan="3">
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Content="Forget saved details" VerticalAlignment="Center"
                        Command="{Binding ForgetCommand}" Visibility="{Binding IsRemembered, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel>
                  <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Remember}" Content="Remember these details on this PC"
                            AutomationProperties.Name="Remember Fyers details" />
                  <TextBlock Style="{StaticResource FieldHint}" Margin="52,4,0,0" TextWrapping="Wrap">
                    <Run Text="Saved after the next successful login; the Secret ID and PIN are encrypted for your Windows account." />
                    <LineBreak />
                    <Run Text="{Binding DetailsSource, Mode=OneWay}" Foreground="{DynamicResource TextSubtleBrush}" />
                  </TextBlock>
                </StackPanel>
              </DockPanel>
            </Grid>

            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,18,0,18" />

            <StackPanel Orientation="Horizontal" Visibility="{Binding IsLoggingIn, Converter={StaticResource InverseBoolToVisibility}}">
              <Button Style="{StaticResource Button.Primary}" ui:Ui.Icon="&#xE8A7;" Content="Log in with Fyers" Padding="20,0"
                      Command="{Binding LogInCommand}" AutomationProperties.Name="Log in with Fyers" />
              <Button Style="{StaticResource Button.Ghost}" Content="Paste the redirect URL instead" Margin="8,0,0,0" Command="{Binding LogInManuallyCommand}"
                      ToolTip="For when this app can't receive the redirect on the local address, e.g. when the port is in use." />
            </StackPanel>

            <!-- While logging in: what's happening, the page link, the paste box for the manual login, and Cancel. -->
            <Border Style="{StaticResource Banner}" Tag="{x:Static vm:StatusLevel.Busy}" Padding="16,14"
                    Visibility="{Binding IsLoggingIn, Converter={StaticResource BoolToVisibility}}">
              <StackPanel>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="Cancel" Margin="12,0,0,0" VerticalAlignment="Top" Command="{Binding CancelCommand}" />
                  <TextBlock Text="{Binding Step}" Style="{StaticResource Text.Body}" />
                </DockPanel>
                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,12,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Visibility="{Binding HasLoginUrl, Converter={StaticResource BoolToVisibility}}">
                  <Button Style="{StaticResource Button.Ghost}" ui:Ui.Icon="&#xE8A7;" Content="Open the page again" Command="{Binding OpenLoginPageCommand}" />
                  <Button Style="{StaticResource Button.Ghost}" ui:Ui.Icon="&#xE8C8;" Content="Copy link" Margin="6,0,0,0" Command="{Binding CopyLoginUrlCommand}" />
                </StackPanel>
                <DockPanel Margin="0,12,0,0" Visibility="{Binding IsAwaitingPaste, Converter={StaticResource BoolToVisibility}}">
                  <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="Continue" Margin="8,0,0,0" Command="{Binding SubmitPastedCommand}" />
                  <TextBox Style="{StaticResource TextBox.Mono}" Text="{Binding PastedUrl, UpdateSourceTrigger=PropertyChanged}"
                           ui:Ui.Placeholder="http://127.0.0.1:8085/callback?s=ok&amp;auth_code=…" AutomationProperties.Name="Redirect URL">
                    <TextBox.InputBindings>
                      <KeyBinding Key="Enter" Command="{Binding SubmitPastedCommand}" />
                    </TextBox.InputBindings>
                  </TextBox>
                </DockPanel>
              </StackPanel>
            </Border>

            <!-- How the last login went, right under the button that started it. -->
            <Border Style="{StaticResource Banner}" Tag="{Binding MessageLevel}" Padding="14,12" Margin="0,14,0,0"
                    Visibility="{Binding Message, Converter={StaticResource VisibleWhenNull}, ConverterParameter=invert}">
              <DockPanel>
                <TextBlock FontSize="16" Margin="0,1,12,0" VerticalAlignment="Top" Foreground="{Binding MessageLevel, Converter={StaticResource ToneBrush}}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Icon}">
                      <Setter Property="Text" Value="&#xE946;" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding MessageLevel}" Value="{x:Static vm:StatusLevel.Good}">
                          <Setter Property="Text" Value="&#xE930;" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <StackPanel>
                  <TextBlock Text="{Binding MessageTitle}" FontWeight="SemiBold" Foreground="{Binding MessageLevel, Converter={StaticResource ToneBrush}}"
                             Visibility="{Binding MessageTitle, Converter={StaticResource VisibleWhenNull}, ConverterParameter=invert}" Margin="0,0,0,2" />
                  <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Body}" />
                </StackPanel>
              </DockPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- Session stored in the service -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,18,20,18" VerticalAlignment="Top">
          <StackPanel>
            <DockPanel Margin="0,0,0,16">
              <ui:StatusPill DockPanel.Dock="Right" Text="{Binding SessionSummary}" Tone="{Binding SessionLevel, Converter={StaticResource Tone}}" />
              <ContentControl Style="{StaticResource IconBadge}" Tag="{Binding SessionLevel}" Content="&#xE77B;" Width="32" Height="32" />
              <TextBlock Text="Session" Style="{StaticResource Text.Section}" Margin="12,0,0,0" VerticalAlignment="Center" />
            </DockPanel>

            <TextBlock Text="{Binding DaysLeftText}" Style="{StaticResource Text.Kpi}" />
            <ProgressBar Value="{Binding Validity, Mode=OneWay}" Maximum="1" Margin="0,10,0,18" AutomationProperties.Name="Login validity" />

            <DockPanel Style="{StaticResource Fact}">
              <TextBlock DockPanel.Dock="Right" Text="{Binding Account}" FontWeight="SemiBold" Style="{StaticResource Text.Mono}" />
              <TextBlock Text="Fyers account" Style="{StaticResource Text.Muted}" />
            </DockPanel>
            <DockPanel Style="{StaticResource Fact}">
              <TextBlock DockPanel.Dock="Right" Text="{Binding LoginValidText}" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
              <TextBlock Text="Login valid" Style="{StaticResource Text.Muted}" />
            </DockPanel>
            <DockPanel Style="{StaticResource Fact}">
              <TextBlock DockPanel.Dock="Right" Text="{Binding TokenText}" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
              <TextBlock Text="Access token" Style="{StaticResource Text.Muted}" />
            </DockPanel>
            <DockPanel Style="{StaticResource Fact}">
              <TextBlock DockPanel.Dock="Right" Text="{Binding UpdatedText}" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
              <TextBlock Text="Last updated" Style="{StaticResource Text.Muted}" />
            </DockPanel>

            <TextBlock Text="{Binding SessionError}" Style="{StaticResource Text.Message}" Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,10"
                       Visibility="{Binding SessionError, Converter={StaticResource VisibleWhenNull}, ConverterParameter=invert}" />
            <DockPanel Visibility="{Binding IsConfirmingLogout, Converter={StaticResource InverseBoolToVisibility}}">
              <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" ui:Ui.Icon="&#xF3B1;" Content="Log out"
                      Command="{Binding AskLogOutCommand}" Visibility="{Binding HasStoredLogin, Converter={StaticResource BoolToVisibility}}"
                      ToolTip="Revoke the token at Fyers and make QuoteSnap forget the login." AutomationProperties.Name="Log out of Fyers" />
              <Button Content="Check again" ui:Ui.Icon="&#xE72C;" HorizontalAlignment="Left" Command="{Binding RefreshSessionCommand}"
                      ui:Ui.IsSpinning="{Binding RefreshSessionCommand.IsRunning}" />
            </DockPanel>

            <!-- Log out asks first: quote requests stop until the next login. -->
            <Border Style="{StaticResource Banner}" Tag="{x:Static vm:StatusLevel.Bad}" Padding="14,12"
                    Visibility="{Binding IsConfirmingLogout, Converter={StaticResource BoolToVisibility}}">
              <StackPanel>
                <TextBlock Text="Log out of Fyers?" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,2" />
                <TextBlock Style="{StaticResource Text.Body}" Margin="0,0,0,12"
                           Text="Fyers revokes QuoteSnap's token and QuoteSnap forgets the login, including the app details and PIN it stored. Quote requests are refused until you log in again." />
                <StackPanel Orientation="Horizontal">
                  <Button Style="{StaticResource Button.Danger}" ui:Ui.Icon="&#xF3B1;" Content="Log out" Command="{Binding LogOutCommand}"
                          ui:Ui.IsSpinning="{Binding LogOutCommand.IsRunning}" AutomationProperties.Name="Confirm log out" />
                  <Button Style="{StaticResource Button.Ghost}" Content="Stay logged in" Margin="8,0,0,0" Command="{Binding KeepLoginCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- How the last logout went. -->
            <Border Style="{StaticResource Banner}" Tag="{Binding SessionMessageLevel}" Padding="14,12" Margin="0,14,0,0"
                    Visibility="{Binding SessionMessage, Converter={StaticResource VisibleWhenNull}, ConverterParameter=invert}">
              <DockPanel>
                <TextBlock FontSize="16" Margin="0,1,12,0" VerticalAlignment="Top" Foreground="{Binding SessionMessageLevel, Converter={StaticResource ToneBrush}}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Icon}">
                      <Setter Property="Text" Value="&#xE946;" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding SessionMessageLevel}" Value="{x:Static vm:StatusLevel.Good}">
                          <Setter Property="Text" Value="&#xE930;" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <StackPanel>
                  <TextBlock Text="{Binding SessionMessageTitle}" FontWeight="SemiBold" Foreground="{Binding SessionMessageLevel, Converter={StaticResource ToneBrush}}"
                             Visibility="{Binding SessionMessageTitle, Converter={StaticResource VisibleWhenNull}, ConverterParameter=invert}" Margin="0,0,0,2" />
                  <TextBlock Text="{Binding SessionMessage}" Style="{StaticResource Text.Body}" />
                </StackPanel>
              </DockPanel>
            </Border>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
