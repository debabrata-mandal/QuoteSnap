<UserControl x:Class="QuoteSnap.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:QuoteSnap.Desktop.Controls"
             xmlns:vm="clr-namespace:QuoteSnap.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
  <UserControl.Resources>
    <Style x:Key="KpiCard" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="Margin" Value="0,0,12,0" />
      <Setter Property="Padding" Value="16,12" />
    </Style>
    <Style x:Key="Text.KpiMedium" TargetType="TextBlock" BasedOn="{StaticResource Text.Kpi}">
      <Setter Property="FontSize" Value="20" />
    </Style>
    <Style x:Key="KpiValueSkeleton" TargetType="Border" BasedOn="{StaticResource Skeleton}">
      <Setter Property="Width" Value="96" />
      <Setter Property="Height" Value="22" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Margin" Value="0,4,0,4" />
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="{StaticResource PageMargin}" DataContext="{Binding Dashboard}">

      <!-- Header -->
      <Grid Margin="0,0,0,22">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Dashboard" Style="{StaticResource Text.PageTitle}" />
          <TextBlock Text="Live health of the QuoteSnap API, your Fyers login and the mutual fund NAV cache." Style="{StaticResource Text.PageSubtitle}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="0,0,8,0" Typography.NumeralAlignment="Tabular"
                     Text="{Binding LastChecked, Converter={StaticResource LocalTime}, ConverterParameter=clock, StringFormat=Updated {0}}" />
          <Button Style="{StaticResource Button.Icon}" ui:Ui.Icon="&#xE72C;" ToolTip="Refresh now (also refreshes every 15 seconds)"
                  AutomationProperties.Name="Refresh" Command="{Binding RefreshCommand}"
                  ui:Ui.IsSpinning="{Binding RefreshCommand.IsRunning}" />
        </StackPanel>
      </Grid>

      <!-- Alert: API offline, key rejected or Fyers login needed -->
      <Border Margin="0,0,0,18" CornerRadius="{StaticResource RadiusCard}" Padding="16,14" BorderThickness="1"
              Background="{Binding AlertLevel, Converter={StaticResource ToneBrush}, ConverterParameter=subtle}"
              BorderBrush="{Binding AlertLevel, Converter={StaticResource ToneBrush}, ConverterParameter=border}"
              Visibility="{Binding AlertTitle, Converter={StaticResource VisibleWhenNull}, ConverterParameter=invert}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE7BA;" FontSize="18" VerticalAlignment="Top" Margin="2,1,14,0"
                     Foreground="{Binding AlertLevel, Converter={StaticResource ToneBrush}}" />
          <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding AlertTitle}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSection}" />
            <TextBlock Text="{Binding AlertText}" Style="{StaticResource Text.Muted}" Margin="0,3,0,0" Foreground="{StaticResource TextBrush}" Opacity="0.8" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
            <Button Style="{StaticResource Button.Ghost}" Content="Open Settings" Margin="0,0,8,0"
                    Visibility="{Binding AlertOffersSettings, Converter={StaticResource BoolToVisibility}}"
                    Command="{Binding DataContext.GoToCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="4" />
            <Button Style="{StaticResource Button.Primary}" ui:Ui.Icon="&#xE8D7;" Content="Log in to Fyers" Margin="0,0,8,0"
                    Visibility="{Binding AlertOffersLogin, Converter={StaticResource BoolToVisibility}}"
                    Command="{Binding DataContext.GoToCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="6" />
            <Button Style="{StaticResource Button.Secondary}" Content="Try again" Command="{Binding RefreshCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Portfolio today -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="22,18"
              Visibility="{Binding Portfolio, Converter={StaticResource VisibleWhenNull}, ConverterParameter=invert}">
        <Grid DataContext="{Binding Portfolio}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="240" />
            <ColumnDefinition Width="*" MinWidth="220" MaxWidth="380" />
            <ColumnDefinition Width="*" MinWidth="220" MaxWidth="380" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
            <TextBlock Text="YOUR FUNDS TODAY · ESTIMATED" Style="{StaticResource Text.Label}" />
            <ui:RollingText Text="{Binding ChangeText}" Key="dashboard:portfolio" Margin="0,4,0,2" HorizontalAlignment="Left" FontFamily="{StaticResource DisplayFont}"
                            FontSize="{StaticResource FontSizeKpi}" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"
                            Foreground="{Binding ChangePercent, Converter={StaticResource SignBrush}}" />
            <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Muted}" TextTrimming="CharacterEllipsis"
                       ToolTip="The average of each fund's estimated NAV change, as if the same amount were invested in each fund" />
          </StackPanel>
          <Border Grid.Column="1" Margin="16,0,0,0" CornerRadius="{StaticResource RadiusCard}" ClipToBounds="True"
                  Background="{StaticResource FillSubtleBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ToolTip="{Binding Best.SchemeName}">
            <DockPanel>
            <Border DockPanel.Dock="Left" Width="3" Margin="0,10" CornerRadius="0,2,2,0" Background="{Binding BestChange, Converter={StaticResource SignBrush}}" />
            <StackPanel Margin="13,12,14,12">
              <DockPanel>
                <Border DockPanel.Dock="Right" CornerRadius="{StaticResource RadiusPill}" Padding="7,1" VerticalAlignment="Center"
                        Background="{Binding BestChange, Converter={StaticResource SignBrush}, ConverterParameter=subtle}">
                  <ui:RollingText Text="{Binding BestText}" Key="dashboard:best" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"
                                  Foreground="{Binding BestChange, Converter={StaticResource SignBrush}}" />
                </Border>
                <TextBlock Text="BEST FUND" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
              </DockPanel>
              <TextBlock Text="{Binding Best.SchemeName}" FontWeight="SemiBold" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
              <StackPanel Orientation="Horizontal" Margin="0,3,0,0" ToolTip="Today's estimated NAV">
                <TextBlock Text="Est. NAV " Style="{StaticResource Text.Muted}" />
                <ui:RollingText Text="{Binding BestNavText}" Key="dashboard:best:nav" FontSize="{StaticResource FontSizeSmall}" Typography.NumeralAlignment="Tabular"
                                Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
            </DockPanel>
          </Border>
          <Border Grid.Column="2" Margin="12,0,0,0" CornerRadius="{StaticResource RadiusCard}" ClipToBounds="True"
                  Background="{StaticResource FillSubtleBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ToolTip="{Binding Worst.SchemeName}">
            <DockPanel>
            <Border DockPanel.Dock="Left" Width="3" Margin="0,10" CornerRadius="0,2,2,0" Background="{Binding WorstChange, Converter={StaticResource SignBrush}}" />
            <StackPanel Margin="13,12,14,12">
              <DockPanel>
                <Border DockPanel.Dock="Right" CornerRadius="{StaticResource RadiusPill}" Padding="7,1" VerticalAlignment="Center"
                        Background="{Binding WorstChange, Converter={StaticResource SignBrush}, ConverterParameter=subtle}">
                  <ui:RollingText Text="{Binding WorstText}" Key="dashboard:worst" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"
                                  Foreground="{Binding WorstChange, Converter={StaticResource SignBrush}}" />
                </Border>
                <TextBlock Text="WORST FUND" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
              </DockPanel>
              <TextBlock Text="{Binding Worst.SchemeName}" FontWeight="SemiBold" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
              <StackPanel Orientation="Horizontal" Margin="0,3,0,0" ToolTip="Today's estimated NAV">
                <TextBlock Text="Est. NAV " Style="{StaticResource Text.Muted}" />
                <ui:RollingText Text="{Binding WorstNavText}" Key="dashboard:worst:nav" FontSize="{StaticResource FontSizeSmall}" Typography.NumeralAlignment="Tabular"
                                Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
            </DockPanel>
          </Border>
        </Grid>
      </Border>

      <!-- Top holdings -->
      <Border Style="{StaticResource Card}" Padding="0">
        <StackPanel>
          <DockPanel Margin="20,14,12,10">
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Content="View holdings"
                    Command="{Binding DataContext.GoToCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="5" />
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Content="See all stocks" Margin="0,0,4,0"
                    Command="{Binding DataContext.GoToCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="7" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Top holdings" Style="{StaticResource Text.Section}" />
              <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center" DataContext="{Binding Breadth}" ToolTip="{Binding Tooltip}"
                          Visibility="{Binding Converter={StaticResource VisibleWhenNull}, ConverterParameter=invert}">
                <Border Width="1" Height="16" Margin="0,0,16,0" VerticalAlignment="Center" Background="{StaticResource BorderBrush}" />
                <TextBlock Text="Advances" Style="{StaticResource Text.Muted}" Margin="0,0,6,0" VerticalAlignment="Center" />
                <ui:RollingText Text="{Binding AdvancesText}" Key="dashboard:advances" VerticalAlignment="Center" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" Foreground="{StaticResource SuccessBrush}" />
                <Grid Width="110" Height="4" Margin="10,0,10,0" VerticalAlignment="Center">
                  <Border CornerRadius="2" Background="{StaticResource DangerBrush}" />
                  <Border CornerRadius="2" Background="{StaticResource SuccessBrush}" RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform>
                      <ScaleTransform ScaleX="{Binding AdvanceShare}" />
                    </Border.RenderTransform>
                  </Border>
                </Grid>
                <ui:RollingText Text="{Binding DeclinesText}" Key="dashboard:declines" VerticalAlignment="Center" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" Foreground="{StaticResource DangerBrush}" />
                <TextBlock Text="Declines" Style="{StaticResource Text.Muted}" Margin="6,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Detail, StringFormat=· {0}}" Style="{StaticResource Text.Muted}" Margin="10,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
          </DockPanel>
          <ItemsControl ItemsSource="{Binding TopHoldings}" Margin="16,0,4,4" AutomationProperties.Name="Top holdings"
                        Visibility="{Binding TopHoldings, Converter={StaticResource VisibleWhenEmpty}, ConverterParameter=invert}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="5" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:TopHoldingRow}">
                <Border Margin="0,0,10,10" Padding="12,9,12,10" CornerRadius="{StaticResource RadiusCard}" BorderThickness="1"
                        Background="{StaticResource FillSubtleBrush}" BorderBrush="{StaticResource BorderBrush}" ToolTip="{Binding Tip}">
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    <DockPanel Margin="0,6,0,0">
                      <Border DockPanel.Dock="Right" CornerRadius="{StaticResource RadiusPill}" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center"
                              Background="{Binding DayChangePercent, Converter={StaticResource SignBrush}, ConverterParameter=subtle}">
                        <ui:RollingText Text="{Binding DayChangeText}" Key="{Binding Symbol, StringFormat=dashboard:{0}:day}" FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold"
                                        Typography.NumeralAlignment="Tabular" Foreground="{Binding DayChangePercent, Converter={StaticResource SignBrush}}" />
                      </Border>
                      <ui:RollingText Text="{Binding PriceText}" Key="{Binding Symbol, StringFormat=dashboard:{0}:price}" FontSize="18" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"
                                      HorizontalAlignment="Left" />
                    </DockPanel>
                    <ProgressBar Height="3" Maximum="1" Value="{Binding BarFraction, Mode=OneWay}" Margin="0,7,0,5" Foreground="{StaticResource AccentGradientHorizontalBrush}" />
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding FundsText}" Style="{StaticResource Text.Muted}" FontSize="{StaticResource FontSizeCaption}"
                                 VerticalAlignment="Bottom" ToolTip="{Binding FundsTip}" />
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding WeightText}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSmall}" Typography.NumeralAlignment="Tabular" />
                        <TextBlock Text="weight" Style="{StaticResource Text.Muted}" FontSize="{StaticResource FontSizeCaption}" Margin="4,0,0,0" VerticalAlignment="Bottom" />
                      </StackPanel>
                    </DockPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Margin="20,26,20,34" HorizontalAlignment="Center"
                      Visibility="{Binding TopHoldings, Converter={StaticResource VisibleWhenEmpty}}">
            <Border Width="52" Height="52" CornerRadius="26" Background="{StaticResource FillSubtleBrush}" HorizontalAlignment="Center">
              <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE9D2;" FontSize="20" Foreground="{StaticResource TextSubtleBrush}" />
            </Border>
            <TextBlock Text="{Binding TopHoldingsEmptyText}" Style="{StaticResource Text.Muted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0" MaxWidth="360" />
          </StackPanel>
        </StackPanel>
      </Border>
      <!-- Status -->
      <TextBlock Text="STATUS" Style="{StaticResource Text.Label}" Margin="2,28,0,10" />
      <Grid Margin="0,0,-12,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource KpiCard}" ToolTip="{Binding ApiDetailTooltip}">
          <StackPanel>
            <DockPanel LastChildFill="False">
              <ContentControl Style="{StaticResource IconBadge}" Tag="{Binding ApiLevel}" Content="&#xE774;" />
              <ui:StatusPill DockPanel.Dock="Right" Text="{Binding ApiSummary}" Tone="{Binding ApiLevel, Converter={StaticResource Tone}}" />
            </DockPanel>
            <TextBlock Text="QUOTESNAP API" Style="{StaticResource Text.Label}" Margin="0,10,0,0" />
            <Border Style="{StaticResource KpiValueSkeleton}" Visibility="{Binding LastChecked, Converter={StaticResource VisibleWhenNull}}" />
            <TextBlock Text="{Binding ApiValue}" Style="{StaticResource Text.KpiMedium}" Margin="0,2,0,2"
                       Visibility="{Binding LastChecked, Converter={StaticResource VisibleWhenNull}, ConverterParameter=invert}" />
            <TextBlock Text="{Binding ApiDetail}" Style="{StaticResource Text.Muted}" />
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource KpiCard}" ToolTip="{Binding FyersDetail}">
          <StackPanel>
            <DockPanel LastChildFill="False">
              <ContentControl Style="{StaticResource IconBadge}" Tag="{Binding FyersLevel}" Content="&#xE8D7;" />
              <ui:StatusPill DockPanel.Dock="Right" Text="{Binding FyersSummary}" Tone="{Binding FyersLevel, Converter={StaticResource Tone}}" />
            </DockPanel>
            <TextBlock Text="FYERS LOGIN" Style="{StaticResource Text.Label}" Margin="0,10,0,0" />
            <Border Style="{StaticResource KpiValueSkeleton}" Visibility="{Binding LastChecked, Converter={StaticResource VisibleWhenNull}}" />
            <StackPanel Orientation="Horizontal" Margin="0,2,0,2"
                        Visibility="{Binding LastChecked, Converter={StaticResource VisibleWhenNull}, ConverterParameter=invert}">
              <TextBlock Text="{Binding FyersValue}" Style="{StaticResource Text.KpiMedium}" />
              <TextBlock Text="left" Style="{StaticResource Text.Muted}" VerticalAlignment="Bottom" Margin="6,0,0,3"
                         Visibility="{Binding HasFyersValue, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <ProgressBar Height="4" Maximum="1" Value="{Binding FyersValidity, Mode=OneWay}" Margin="0,2,0,10"
                         Visibility="{Binding HasFyersValue, Converter={StaticResource BoolToVisibility}}"
                         Foreground="{Binding FyersLevel, Converter={StaticResource ToneBrush}}" />
            <TextBlock Text="{Binding FyersDetail}" Style="{StaticResource Text.Muted}" />
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource KpiCard}" ToolTip="{Binding LiveFeed.Tip}">
          <StackPanel DataContext="{Binding LiveFeed}">
            <DockPanel LastChildFill="False">
              <ContentControl Style="{StaticResource IconBadge}" Tag="{Binding Level}" Content="&#xE9D9;" />
              <ui:StatusPill DockPanel.Dock="Right" Text="{Binding Summary}" Tone="{Binding Level, Converter={StaticResource Tone}}" />
            </DockPanel>
            <TextBlock Text="LIVE FEED" Style="{StaticResource Text.Label}" Margin="0,10,0,0" />
            <Border Style="{StaticResource KpiValueSkeleton}" Visibility="{Binding DataContext.LastChecked, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource VisibleWhenNull}}" />
            <StackPanel Orientation="Horizontal" Margin="0,2,0,2"
                        Visibility="{Binding DataContext.LastChecked, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource VisibleWhenNull}, ConverterParameter=invert}">
              <TextBlock Text="{Binding Value}" Style="{StaticResource Text.KpiMedium}" />
              <TextBlock Text="stocks hooked" Style="{StaticResource Text.Muted}" VerticalAlignment="Bottom" Margin="6,0,0,3"
                         Visibility="{Binding HasValue, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <ProgressBar Height="4" Maximum="1" Value="{Binding CapFraction, Mode=OneWay}" Margin="0,2,0,10"
                         Visibility="{Binding HasValue, Converter={StaticResource BoolToVisibility}}"
                         Foreground="{Binding Level, Converter={StaticResource ToneBrush}}" />
            <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Muted}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>

        <Border Grid.Column="3" Style="{StaticResource KpiCard}" ToolTip="{Binding NavDetail}">
          <StackPanel>
            <DockPanel LastChildFill="False">
              <ContentControl Style="{StaticResource IconBadge}" Tag="{Binding NavLevel}" Content="&#xE825;" />
              <ui:StatusPill DockPanel.Dock="Right" Text="{Binding NavSummary}" Tone="{Binding NavLevel, Converter={StaticResource Tone}}" />
            </DockPanel>
            <TextBlock Text="MUTUAL FUND NAVS" Style="{StaticResource Text.Label}" Margin="0,10,0,0" />
            <Border Style="{StaticResource KpiValueSkeleton}" Visibility="{Binding LastChecked, Converter={StaticResource VisibleWhenNull}}" />
            <StackPanel Orientation="Horizontal" Margin="0,2,0,2"
                        Visibility="{Binding LastChecked, Converter={StaticResource VisibleWhenNull}, ConverterParameter=invert}">
              <TextBlock Text="{Binding NavValue}" Style="{StaticResource Text.KpiMedium}" />
              <TextBlock Text="schemes" Style="{StaticResource Text.Muted}" VerticalAlignment="Bottom" Margin="6,0,0,3"
                         Visibility="{Binding HasNavValue, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <TextBlock Text="{Binding NavDetail}" Style="{StaticResource Text.Muted}" />
          </StackPanel>
        </Border>

        <Border Grid.Column="4" Style="{StaticResource KpiCard}" ToolTip="{Binding RequestsDetail}">
          <StackPanel>
            <DockPanel LastChildFill="False">
              <ContentControl Style="{StaticResource IconBadge}" Tag="{x:Static ui:Tone.Accent}" Content="&#xE945;" />
              <ui:StatusPill DockPanel.Dock="Right" Text="{Binding RequestsSummary}" Tone="{Binding RequestsLevel, Converter={StaticResource Tone}}" />
            </DockPanel>
            <TextBlock Text="REQUESTS TODAY" Style="{StaticResource Text.Label}" Margin="0,10,0,0" />
            <Border Style="{StaticResource KpiValueSkeleton}" Visibility="{Binding LastChecked, Converter={StaticResource VisibleWhenNull}}" />
            <TextBlock Text="{Binding RequestsValue}" Style="{StaticResource Text.KpiMedium}" Margin="0,2,0,2"
                       Visibility="{Binding LastChecked, Converter={StaticResource VisibleWhenNull}, ConverterParameter=invert}" />
            <TextBlock Text="{Binding RequestsDetail}" Style="{StaticResource Text.Muted}" />
          </StackPanel>
        </Border>
      </Grid>

    </StackPanel>
  </ScrollViewer>
</UserControl>
