<UserControl x:Class="QuoteSnap.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:QuoteSnap.Desktop.Controls"
             xmlns:vm="clr-namespace:QuoteSnap.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
  <UserControl.Resources>
    <!-- One Windows 11 style settings row: icon, title and description on the left, the control on the right. -->
    <Style x:Key="SettingRow" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
      <Setter Property="Padding" Value="18,14" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="MinHeight" Value="68" />
    </Style>
    <Style x:Key="SettingIcon" TargetType="TextBlock" BasedOn="{StaticResource Text.Icon}">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="Width" Value="24" />
      <Setter Property="Margin" Value="0,0,16,0" />
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>
    <Style x:Key="SettingTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="SettingDescription" TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style x:Key="Group" TargetType="TextBlock" BasedOn="{StaticResource Text.Section}">
      <Setter Property="Margin" Value="2,24,0,10" />
    </Style>
    <!-- Shows or hides the key next to it. -->
    <Style x:Key="RevealToggle" TargetType="ToggleButton" BasedOn="{StaticResource Button.Icon}">
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="ui:Ui.Icon" Value="&#xE7B3;" />
      <Setter Property="ToolTip" Value="Show key" />
      <Style.Triggers>
        <Trigger Property="IsChecked" Value="True">
          <Setter Property="ui:Ui.Icon" Value="&#xED1A;" />
          <Setter Property="ToolTip" Value="Hide key" />
          <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="{StaticResource PageMargin}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MaxWidth="920" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Settings" Style="{StaticResource Text.PageTitle}" />
        <TextBlock Text="How the app reaches the QuoteSnap API. To log in to Fyers, open the Fyers login page." Style="{StaticResource Text.PageSubtitle}" />

        <TextBlock Text="Connection" Style="{StaticResource Group}" />

        <Border Style="{StaticResource SettingRow}">
          <DockPanel>
            <TextBox DockPanel.Dock="Right" Width="340" Style="{StaticResource TextBox.Mono}" VerticalAlignment="Center"
                     Text="{Binding BaseAddressText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="API address"
                     ui:Ui.Placeholder="http://127.0.0.1:8080/" />
            <TextBlock Style="{StaticResource SettingIcon}" Text="&#xE774;" />
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
              <TextBlock Text="API address" Style="{StaticResource SettingTitle}" />
              <TextBlock Text="Where the QuoteSnap API listens, e.g. http://127.0.0.1:8080/" Style="{StaticResource SettingDescription}" />
            </StackPanel>
          </DockPanel>
        </Border>

        <Border Style="{StaticResource SettingRow}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Grid Width="300">
                <PasswordBox x:Name="ApiKeyBox" PasswordChanged="OnPasswordChanged" AutomationProperties.Name="API key"
                             Visibility="{Binding IsApiKeyVisible, Converter={StaticResource InverseBoolToVisibility}}" />
                <TextBox Style="{StaticResource TextBox.Mono}" Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="API key (visible)"
                         Visibility="{Binding IsApiKeyVisible, Converter={StaticResource BoolToVisibility}}" />
              </Grid>
              <ToggleButton Style="{StaticResource RevealToggle}" IsChecked="{Binding IsApiKeyVisible}" AutomationProperties.Name="Show API key" />
            </StackPanel>
            <TextBlock Style="{StaticResource SettingIcon}" Text="&#xE8D7;" />
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
              <TextBlock Text="API key" Style="{StaticResource SettingTitle}" />
              <TextBlock Text="Sent as X-Api-Key; must match Auth__ApiKey in the API's .env" Style="{StaticResource SettingDescription}" />
            </StackPanel>
          </DockPanel>
        </Border>

        <Border Style="{StaticResource SettingRow}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Grid Width="300">
                <PasswordBox x:Name="AdminApiKeyBox" PasswordChanged="OnPasswordChanged" AutomationProperties.Name="Admin API key"
                             Visibility="{Binding IsAdminApiKeyVisible, Converter={StaticResource InverseBoolToVisibility}}" />
                <TextBox Style="{StaticResource TextBox.Mono}" Text="{Binding AdminApiKey, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Admin API key (visible)"
                         Visibility="{Binding IsAdminApiKeyVisible, Converter={StaticResource BoolToVisibility}}" />
              </Grid>
              <ToggleButton Style="{StaticResource RevealToggle}" IsChecked="{Binding IsAdminApiKeyVisible}" AutomationProperties.Name="Show admin API key" />
            </StackPanel>
            <TextBlock Style="{StaticResource SettingIcon}" Text="&#xE72E;" />
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
              <TextBlock Text="Admin API key" Style="{StaticResource SettingTitle}" />
              <TextBlock Text="Only for the Fyers login; must match Auth__AdminApiKey in the API's .env" Style="{StaticResource SettingDescription}" />
            </StackPanel>
          </DockPanel>
        </Border>

        <Border Style="{StaticResource SettingRow}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <ui:StatusPill Margin="0,0,12,0" Text="{Binding MessagePill}" Tone="{Binding MessageLevel, Converter={StaticResource Tone}}"
                             Visibility="{Binding MessagePill, Converter={StaticResource VisibleWhenNull}, ConverterParameter=invert}" />
              <Button Content="Test connection" ui:Ui.Icon="&#xE703;" Command="{Binding TestCommand}" ui:Ui.IsSpinning="{Binding TestCommand.IsRunning}" />
            </StackPanel>
            <TextBlock Style="{StaticResource SettingIcon}" Text="&#xE703;" />
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
              <TextBlock Text="Test connection" Style="{StaticResource SettingTitle}" />
              <TextBlock Text="{Binding Message, TargetNullValue=Checks that the API is reachable with these values before you save them.}"
                         Style="{StaticResource SettingDescription}" />
            </StackPanel>
          </DockPanel>
        </Border>

        <TextBlock Text="Saved settings" Style="{StaticResource Group}" />

        <Border Style="{StaticResource SettingRow}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Style="{StaticResource Button.Ghost}" Content="Remove saved settings" Command="{Binding ResetCommand}" Margin="0,0,8,0"
                      Visibility="{Binding IsSaved, Converter={StaticResource BoolToVisibility}}" />
              <Button Style="{StaticResource Button.Primary}" ui:Ui.Icon="&#xE74E;" Content="Save" Padding="20,0" Command="{Binding SaveCommand}" />
            </StackPanel>
            <TextBlock Style="{StaticResource SettingIcon}" Text="&#xE74E;" />
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
              <TextBlock Text="Current source" Style="{StaticResource SettingTitle}" />
              <TextBlock Text="{Binding Source}" Style="{StaticResource SettingDescription}" />
            </StackPanel>
          </DockPanel>
        </Border>

        <Border Style="{StaticResource SettingRow}">
          <DockPanel>
            <TextBlock Style="{StaticResource SettingIcon}" Text="&#xE8B7;" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Settings file" Style="{StaticResource SettingTitle}" />
              <TextBlock Text="{Binding SettingsPath}" Style="{StaticResource Text.Mono}" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" />
              <TextBlock Text="The API keys are encrypted for your Windows account before they're saved." Style="{StaticResource SettingDescription}" />
            </StackPanel>
          </DockPanel>
        </Border>

        <TextBlock Text="About" Style="{StaticResource Group}" />

        <Border Style="{StaticResource SettingRow}">
          <DockPanel>
            <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource AccentGradientBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
              <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE9D2;" FontSize="14" Foreground="White" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="QuoteSnap Desktop" Style="{StaticResource SettingTitle}" />
              <TextBlock Style="{StaticResource SettingDescription}">
                <Run Text="Version" />
                <Run Text="{Binding AppVersion, Mode=OneWay}" />
                <Run Text="·" />
                <Run Text="{Binding Runtime, Mode=OneWay}" />
              </TextBlock>
            </StackPanel>
          </DockPanel>
        </Border>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
