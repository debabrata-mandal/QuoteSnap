<UserControl x:Class="QuoteSnap.Desktop.Views.StocksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:QuoteSnap.Desktop.Controls"
             xmlns:vm="clr-namespace:QuoteSnap.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:StocksViewModel}">
  <UserControl.Resources>
    <!-- One stock: name, "NSE:HAL-EQ · Aerospace & Defence", average weight with a bar, how many funds hold it, price and day change. -->
    <DataTemplate x:Key="StockTemplate" DataType="{x:Type vm:TopHoldingRow}">
      <Border x:Name="Row" Padding="20,10,20,10" Background="Transparent" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="96" />
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="96" />
          </Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Tip}" />
            <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Muted}" FontSize="{StaticResource FontSizeCaption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
            <TextBlock Text="{Binding WeightText}" FontWeight="SemiBold" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular" />
            <ProgressBar Height="3" Maximum="1" Value="{Binding BarFraction, Mode=OneWay}" Margin="24,5,0,0" Foreground="{StaticResource AccentGradientHorizontalBrush}" />
          </StackPanel>
          <TextBlock Grid.Column="2" Text="{Binding FundsText}" Style="{StaticResource Text.Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"
                     Typography.NumeralAlignment="Tabular" ToolTip="{Binding FundsTip}" />
          <ui:RollingText Grid.Column="3" Text="{Binding PriceText}" Key="{Binding Symbol, StringFormat=stocks:{0}:price}" FontWeight="SemiBold" HorizontalAlignment="Right"
                          VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
          <ui:RollingText Grid.Column="4" Text="{Binding DayChangeText}" Key="{Binding Symbol, StringFormat=stocks:{0}:day}" FontWeight="SemiBold" HorizontalAlignment="Right"
                          VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" Foreground="{Binding DayChangePercent, Converter={StaticResource SignBrush}}" />
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
          <Setter TargetName="Row" Property="Background" Value="{StaticResource HoverBrush}" />
        </Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Margin="{StaticResource PageMargin}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="320" />
    </Grid.RowDefinitions>

    <StackPanel Margin="0,0,0,22">
      <TextBlock Text="Stocks" Style="{StaticResource Text.PageTitle}" />
      <TextBlock Text="Every listed stock your funds hold, largest average weight first: each stock's weight in each fund, averaged over all your funds with holdings. Prices update as they stream in."
                 Style="{StaticResource Text.PageSubtitle}" TextWrapping="Wrap" />
    </StackPanel>

    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="20,14,14,12">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Grid Width="280" Margin="0,0,6,0">
              <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Padding="34,7,34,7" TextChanged="OnFilterChanged"
                       ui:Ui.Placeholder="Filter by name, symbol or sector" AutomationProperties.Name="Filter stocks">
                <TextBox.InputBindings>
                  <KeyBinding Key="Escape" Command="{Binding ClearFilterCommand}" />
                </TextBox.InputBindings>
              </TextBox>
              <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE71C;" FontSize="13" HorizontalAlignment="Left" Margin="13,0,0,0"
                         Foreground="{StaticResource TextSubtleBrush}" IsHitTestVisible="False" />
              <Button Style="{StaticResource Button.Icon}" ui:Ui.Icon="&#xE711;" Width="26" Height="26" HorizontalAlignment="Right" Margin="0,0,5,0"
                      ToolTip="Clear the filter" AutomationProperties.Name="Clear the filter" Command="{Binding ClearFilterCommand}"
                      Visibility="{Binding FilterText, Converter={StaticResource VisibleWhenNull}, ConverterParameter=invert}" />
            </Grid>
            <Button Style="{StaticResource Button.Icon}" ui:Ui.Icon="&#xE72C;" ToolTip="Reload the stocks" AutomationProperties.Name="Reload stocks"
                    Command="{Binding RefreshCommand}" ui:Ui.IsSpinning="{Binding RefreshCommand.IsRunning}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="All holdings" Style="{StaticResource Text.Section}" />
            <Border Style="{StaticResource Chip}" Margin="10,0,0,0" Padding="7,1" VerticalAlignment="Center"
                    Visibility="{Binding Summary, Converter={StaticResource VisibleWhenNull}, ConverterParameter=invert}">
              <TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeCaption}" />
            </Border>
            <TextBlock Text="{Binding Caption}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </DockPanel>

        <Border DockPanel.Dock="Top" Style="{StaticResource Banner}" Tag="{x:Static vm:StatusLevel.Warning}" Margin="20,0,20,12"
                Visibility="{Binding Error, Converter={StaticResource VisibleWhenNull}, ConverterParameter=invert}">
          <TextBlock Text="{Binding Error}" Style="{StaticResource Text.Body}" FontSize="{StaticResource FontSizeSmall}" />
        </Border>

        <Grid DockPanel.Dock="Top" Margin="20,0,32,8" Visibility="{Binding HasStocks, Converter={StaticResource BoolToVisibility}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="96" />
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="96" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="STOCK" Style="{StaticResource Text.Label}" />
          <TextBlock Grid.Column="1" Text="AVG. WEIGHT" Style="{StaticResource Text.Label}" TextAlignment="Right" Margin="0,0,8,0"
                     ToolTip="The stock's weight in each fund, averaged over all your funds with holdings" />
          <TextBlock Grid.Column="2" Text="FUNDS" Style="{StaticResource Text.Label}" TextAlignment="Right" ToolTip="How many of your funds hold the stock" />
          <TextBlock Grid.Column="3" Text="PRICE" Style="{StaticResource Text.Label}" TextAlignment="Right" />
          <TextBlock Grid.Column="4" Text="DAY" Style="{StaticResource Text.Label}" TextAlignment="Right" ToolTip="Today's change" />
        </Grid>
        <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource DividerBrush}"
                Visibility="{Binding HasStocks, Converter={StaticResource BoolToVisibility}}" />

        <Grid>
          <ItemsControl x:Name="List" ItemsSource="{Binding StocksView}" ItemTemplate="{StaticResource StockTemplate}" Focusable="False" AutomationProperties.Name="Stocks"
                        VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.Template>
              <ControlTemplate TargetType="ItemsControl">
                <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" CanContentScroll="True">
                  <ItemsPresenter Margin="0,0,0,8" />
                </ScrollViewer>
              </ControlTemplate>
            </ItemsControl.Template>
          </ItemsControl>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,40" MaxWidth="360"
                      Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}">
            <Border Width="52" Height="52" CornerRadius="26" Background="{StaticResource FillSubtleBrush}" HorizontalAlignment="Center">
              <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE9D2;" FontSize="20" Foreground="{StaticResource TextSubtleBrush}" />
            </Border>
            <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Text.Muted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0" />
          </StackPanel>
        </Grid>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>