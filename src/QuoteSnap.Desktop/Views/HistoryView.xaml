<UserControl x:Class="QuoteSnap.Desktop.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:QuoteSnap.Desktop.Controls"
             xmlns:views="clr-namespace:QuoteSnap.Desktop.Views"
             xmlns:vm="clr-namespace:QuoteSnap.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:HistoryViewModel}">
  <Grid Margin="{StaticResource PageMargin}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="2*" MinHeight="200" />
      <RowDefinition Height="16" />
      <RowDefinition Height="3*" MinHeight="260" />
    </Grid.RowDefinitions>

    <!-- Header with the status filter -->
    <Grid Margin="0,0,0,22">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="History" Style="{StaticResource Text.PageTitle}" />
        <TextBlock Text="Every quote request, newest first. Select one to see and export its quotes." Style="{StaticResource Text.PageSubtitle}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Border Style="{StaticResource SegmentHost}">
          <StackPanel Orientation="Horizontal">
            <StackPanel.Resources>
              <Style TargetType="RadioButton" BasedOn="{StaticResource Segment}">
                <Setter Property="GroupName" Value="HistoryFilter" />
              </Style>
            </StackPanel.Resources>
            <RadioButton Content="All" IsChecked="{Binding StatusFilter, Converter={StaticResource Equals}, ConverterParameter=All}" />
            <RadioButton Content="Running" IsChecked="{Binding StatusFilter, Converter={StaticResource Equals}, ConverterParameter=Running}" />
            <RadioButton Content="Completed" IsChecked="{Binding StatusFilter, Converter={StaticResource Equals}, ConverterParameter=Completed}" />
            <RadioButton Content="With errors" IsChecked="{Binding StatusFilter, Converter={StaticResource Equals}, ConverterParameter=CompletedWithErrors}" />
            <RadioButton Content="Failed" IsChecked="{Binding StatusFilter, Converter={StaticResource Equals}, ConverterParameter=Failed}" />
          </StackPanel>
        </Border>
        <Button Style="{StaticResource Button.Icon}" ui:Ui.Icon="&#xE72C;" Margin="10,0,0,0" ToolTip="Refresh"
                AutomationProperties.Name="Refresh" Command="{Binding RefreshCommand}" ui:Ui.IsSpinning="{Binding RefreshCommand.IsRunning}" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Style="{StaticResource Banner}" Tag="{x:Static vm:StatusLevel.Bad}" Margin="0,0,0,16"
            Visibility="{Binding Message, Converter={StaticResource VisibleWhenNull}, ConverterParameter=invert}">
      <DockPanel>
        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE783;" FontSize="14" Margin="0,1,10,0" VerticalAlignment="Top" Foreground="{DynamicResource DangerBrush}" />
        <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Body}" />
      </DockPanel>
    </Border>

    <!-- Requests -->
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
      <DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="20,8,12,10">
          <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" ui:Ui.Icon="&#xE74B;" Content="Load more"
                  Command="{Binding LoadMoreCommand}" ui:Ui.IsSpinning="{Binding LoadMoreCommand.IsRunning}" />
          <TextBlock Text="{Binding CountText}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
        </DockPanel>
        <Border DockPanel.Dock="Bottom" Height="1" Background="{DynamicResource DividerBrush}" />
        <Grid>
          <DataGrid ItemsSource="{Binding VisibleItems}" SelectedItem="{Binding SelectedItem}" Margin="8,4,8,0" AutomationProperties.Name="Requests">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="Status" Width="190" SortMemberPath="Summary.Status">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <ui:StatusPill Text="{Binding StatusText}" Tone="{Binding Summary.Status, Converter={StaticResource Tone}}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Created" Binding="{Binding CreatedText}" SortMemberPath="Summary.CreatedAt" Width="190"
                                  ElementStyle="{StaticResource Cell.Text}" />
              <DataGridTextColumn Header="Symbols" Binding="{Binding Summary.TotalSymbols, StringFormat=N0}" SortMemberPath="Summary.TotalSymbols" Width="90"
                                  HeaderStyle="{StaticResource Header.Right}" ElementStyle="{StaticResource Cell.Number}" />
              <DataGridTextColumn Header="OK" Binding="{Binding Summary.SucceededCount, StringFormat=N0}" SortMemberPath="Summary.SucceededCount" Width="80"
                                  HeaderStyle="{StaticResource Header.Right}" ElementStyle="{StaticResource Cell.NumberMuted}" />
              <DataGridTextColumn Header="Failed" Binding="{Binding Summary.FailedCount, StringFormat=N0}" SortMemberPath="Summary.FailedCount" Width="80"
                                  HeaderStyle="{StaticResource Header.Right}" ElementStyle="{StaticResource Cell.NumberMuted}" />
              <DataGridTextColumn Header="Took" Binding="{Binding Duration}" Width="100"
                                  HeaderStyle="{StaticResource Header.Right}" ElementStyle="{StaticResource Cell.NumberMuted}" />
              <DataGridTemplateColumn Header="Error" Width="*" MinWidth="120">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Summary.Error}" ToolTip="{Binding Summary.Error}" Style="{StaticResource Cell.Muted}" Margin="12,0,0,0" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="ID" Width="104">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding ShortId}" ToolTip="{Binding Id}" Style="{StaticResource Cell.MonoMuted}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                      Visibility="{Binding VisibleItems, Converter={StaticResource VisibleWhenEmpty}}">
            <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource FillSubtleBrush}" HorizontalAlignment="Center">
              <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE81C;" FontSize="20" Foreground="{DynamicResource TextSubtleBrush}" />
            </Border>
            <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Text.Muted}" TextAlignment="Center" Margin="0,12,0,0" MaxWidth="340" />
          </StackPanel>
        </Grid>
      </DockPanel>
    </Border>

    <!-- Details of the selected request -->
    <Grid Grid.Row="4">
      <Border Style="{StaticResource Card}" Visibility="{Binding SelectedDetails, Converter={StaticResource VisibleWhenNull}}">
        <Grid>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                      Visibility="{Binding IsLoadingDetails, Converter={StaticResource InverseBoolToVisibility}}">
            <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource FillSubtleBrush}" HorizontalAlignment="Center">
              <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE8A1;" FontSize="20" Foreground="{DynamicResource TextSubtleBrush}" />
            </Border>
            <TextBlock Text="Select a request above to see its quotes." Style="{StaticResource Text.Muted}" TextAlignment="Center" Margin="0,12,0,0" />
          </StackPanel>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal"
                      Visibility="{Binding IsLoadingDetails, Converter={StaticResource BoolToVisibility}}">
            <ui:Spinner />
            <TextBlock Text="Loading quotes…" Style="{StaticResource Text.Muted}" Margin="10,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>

      <DockPanel Visibility="{Binding SelectedDetails, Converter={StaticResource VisibleWhenNull}, ConverterParameter=invert}">
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="18,12" Margin="0,0,0,12">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <StackPanel.Resources>
                <Style TargetType="Border" BasedOn="{StaticResource Chip}">
                  <Setter Property="Margin" Value="8,0,0,0" />
                  <Setter Property="Padding" Value="10,4" />
                </Style>
              </StackPanel.Resources>
              <Border>
                <TextBlock Typography.NumeralAlignment="Tabular">
                  <Run Text="TOTAL " Foreground="{DynamicResource TextMutedBrush}" FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold" />
                  <Run Text="{Binding Results.Total, Mode=OneWay, StringFormat=N0}" FontWeight="SemiBold" />
                </TextBlock>
              </Border>
              <Border>
                <TextBlock Typography.NumeralAlignment="Tabular">
                  <Run Text="OK " Foreground="{DynamicResource TextMutedBrush}" FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold" />
                  <Run Text="{Binding Results.Ok, Mode=OneWay, StringFormat=N0}" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" />
                </TextBlock>
              </Border>
              <Border>
                <TextBlock Typography.NumeralAlignment="Tabular">
                  <Run Text="FAILED " Foreground="{DynamicResource TextMutedBrush}" FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold" />
                  <Run Text="{Binding Results.Errors, Mode=OneWay, StringFormat=N0}" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" />
                </TextBlock>
              </Border>
              <Border>
                <TextBlock Typography.NumeralAlignment="Tabular">
                  <Run Text="INVALID " Foreground="{DynamicResource TextMutedBrush}" FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold" />
                  <Run Text="{Binding Results.Invalid, Mode=OneWay, StringFormat=N0}" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" />
                </TextBlock>
              </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <ui:StatusPill Style="{StaticResource StatusPill.Large}" Text="{Binding SelectedDetails.Status, Converter={StaticResource StatusText}}"
                             Tone="{Binding SelectedDetails.Status, Converter={StaticResource Tone}}" />
              <TextBlock Text="{Binding SelectedDetails.RequestId}" Style="{StaticResource Text.Mono}" VerticalAlignment="Center" Margin="14,0,0,0" />
              <Button Style="{StaticResource Button.Icon}" ui:Ui.Icon="&#xE8C8;" Width="28" Height="28" Margin="4,0,0,0" ToolTip="Copy request ID"
                      AutomationProperties.Name="Copy request ID" Command="{Binding CopyRequestIdCommand}" />
              <TextBlock Text="{Binding SelectedSummary}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="NoWrap" />
            </StackPanel>
          </DockPanel>
        </Border>
        <Border DockPanel.Dock="Top" Style="{StaticResource Banner}" Tag="{x:Static vm:StatusLevel.Bad}" Margin="0,0,0,12"
                Visibility="{Binding SelectedDetails.Error, Converter={StaticResource VisibleWhenNull}, ConverterParameter=invert}">
          <TextBlock Text="{Binding SelectedDetails.Error}" Style="{StaticResource Text.Body}" />
        </Border>
        <views:QuoteResultsPanel DataContext="{Binding Results}" />
      </DockPanel>
    </Grid>
  </Grid>
</UserControl>
