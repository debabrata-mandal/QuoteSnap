<UserControl x:Class="QuoteSnap.Desktop.Views.NavView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:QuoteSnap.Desktop.Controls"
             xmlns:vm="clr-namespace:QuoteSnap.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:NavViewModel}">
  <UserControl.Resources>
    <Style x:Key="Fact" TargetType="DockPanel">
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
  </UserControl.Resources>

  <Grid Margin="{StaticResource PageMargin}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="240" />
    </Grid.RowDefinitions>

    <StackPanel Margin="0,0,0,22">
      <TextBlock Text="Mutual funds" Style="{StaticResource Text.PageTitle}" />
      <TextBlock Text="Latest NAVs of Direct Plan schemes from AMFI's daily file, looked up by ISIN." Style="{StaticResource Text.PageSubtitle}" />
    </StackPanel>

    <Border Grid.Row="1" Style="{StaticResource Banner}" Tag="{Binding MessageLevel}" Margin="0,0,0,16"
            Visibility="{Binding Message, Converter={StaticResource VisibleWhenNull}, ConverterParameter=invert}">
      <DockPanel>
        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE946;" FontSize="14" Margin="0,1,10,0" VerticalAlignment="Top"
                   Foreground="{Binding MessageLevel, Converter={StaticResource ToneBrush}}" />
        <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Body}" />
      </DockPanel>
    </Border>

    <Grid Grid.Row="2" Height="244" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="380" />
      </Grid.ColumnDefinitions>

      <!-- ISIN input -->
      <Border Style="{StaticResource Card}" Padding="18,14,18,16">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="2,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Style="{StaticResource Button.Ghost}" ui:Ui.Icon="&#xE8E5;" Content="Load file" Command="{Binding LoadFileCommand}" />
              <Button Style="{StaticResource Button.Ghost}" ui:Ui.Icon="&#xE74D;" Content="Clear" Command="{Binding ClearCommand}" />
            </StackPanel>
            <TextBlock Text="ISINs" Style="{StaticResource Text.Section}" />
          </DockPanel>
          <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" ui:Ui.Icon="&#xE721;" Content="Look up NAVs" Padding="18,0"
                    Command="{Binding LookupCommand}" IsDefault="True" ui:Ui.IsSpinning="{Binding LookupCommand.IsRunning}" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border Style="{StaticResource Chip}" Margin="0" Padding="8,2">
                <TextBlock Text="{Binding IsinSummary}" FontSize="{StaticResource FontSizeSmall}" Typography.NumeralAlignment="Tabular" />
              </Border>
              <TextBlock Text="Growth or IDCW ISINs; drop a file onto the box to load it" Style="{StaticResource Text.Muted}"
                         Foreground="{StaticResource TextSubtleBrush}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DockPanel>
          <TextBox Style="{StaticResource TextBox.Editor}" Text="{Binding IsinText, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper"
                   ui:Ui.FileDropCommand="{Binding DropTextCommand}" AutomationProperties.Name="ISINs"
                   ui:Ui.Placeholder="INF179K01YV8&#10;INF209K01YN0" />
        </DockPanel>
      </Border>

      <!-- NAV cache status and refresh -->
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,14,18,16">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <ui:StatusPill DockPanel.Dock="Right" Text="{Binding StatusSummary}" Tone="{Binding StatusLevel, Converter={StaticResource Tone}}" />
            <ContentControl Style="{StaticResource IconBadge}" Tag="{Binding StatusLevel}" Content="&#xE825;" Width="32" Height="32" />
            <TextBlock Text="AMFI NAV file" Style="{StaticResource Text.Section}" Margin="12,0,0,0" />
          </DockPanel>

          <StackPanel DockPanel.Dock="Bottom">
            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,10"
                         Visibility="{Binding RefreshNavsCommand.IsRunning, Converter={StaticResource BoolToVisibility}}" />
            <Button Style="{StaticResource Button.Primary}" ui:Ui.Icon="&#xE896;" HorizontalAlignment="Stretch"
                    Command="{Binding RefreshNavsCommand}" ui:Ui.IsSpinning="{Binding RefreshNavsCommand.IsRunning}"
                    Content="Refresh NAVs" AutomationProperties.Name="Refresh NAVs"
                    ToolTip="Downloads AMFI's NAVAll.txt again (about 2 MB) and replaces the cache." />
          </StackPanel>

          <StackPanel>
            <DockPanel Style="{StaticResource Fact}">
              <TextBlock DockPanel.Dock="Right" Text="{Binding SchemeCountText}" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
              <TextBlock Text="Direct Plan schemes" Style="{StaticResource Text.Muted}" />
            </DockPanel>
            <DockPanel Style="{StaticResource Fact}">
              <TextBlock DockPanel.Dock="Right" Text="{Binding LoadedAtText}" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
              <TextBlock Text="Downloaded" Style="{StaticResource Text.Muted}" />
            </DockPanel>
            <DockPanel Style="{StaticResource Fact}">
              <TextBlock DockPanel.Dock="Right" Text="{Binding LatestNavDateText}" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
              <TextBlock Text="Latest NAV date" Style="{StaticResource Text.Muted}" />
            </DockPanel>
            <TextBlock Text="{Binding StatusError}" Style="{StaticResource Text.Message}" Foreground="{StaticResource WarningBrush}"
                       MaxHeight="36" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusError}" />
          </StackPanel>
        </DockPanel>
      </Border>
    </Grid>

    <!-- Results -->
    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="20,14,14,12">
          <Button DockPanel.Dock="Right" Content="Export CSV" ui:Ui.Icon="&#xEDE1;" Command="{Binding ExportCommand}" />
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Schemes" Style="{StaticResource Text.Section}" />
            <Border Style="{StaticResource Chip}" Margin="10,0,0,0" Padding="7,1" VerticalAlignment="Center"
                    Visibility="{Binding ResultSummary, Converter={StaticResource VisibleWhenNull}, ConverterParameter=invert}">
              <TextBlock Text="{Binding ResultSummary}" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeCaption}" />
            </Border>
          </StackPanel>
        </DockPanel>

        <DockPanel DockPanel.Dock="Top" Margin="20,0,14,10"
                   Visibility="{Binding NotFound, Converter={StaticResource VisibleWhenEmpty}, ConverterParameter=invert}">
          <TextBlock Text="NOT FOUND" Style="{StaticResource Text.Label}" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Top" Margin="0,5,12,0" />
          <ItemsControl ItemsSource="{Binding NotFound}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Banner}" Tag="{x:Static ui:Tone.Danger}" Padding="8,2" Margin="0,0,6,6" CornerRadius="6">
                  <TextBlock Text="{Binding}" Style="{StaticResource Text.Mono}" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource DangerBrush}" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>

        <Grid>
          <DataGrid ItemsSource="{Binding Funds}" Margin="8,0,8,8" MinRowHeight="52" AutomationProperties.Name="Schemes">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="Scheme" Width="*" MinWidth="300" SortMemberPath="SchemeName">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel VerticalAlignment="Center" ToolTip="{Binding Category}">
                      <TextBlock Text="{Binding SchemeName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Style="{StaticResource Cell.Muted}" FontSize="{StaticResource FontSizeSmall}" Margin="0,2,0,0">
                        <Run Text="{Binding FundHouse, Mode=OneWay}" />
                        <Run Text="·" Foreground="{StaticResource TextSubtleBrush}" />
                        <Run Text="{Binding Category, Mode=OneWay}" />
                      </TextBlock>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="ISIN" Width="130" SortMemberPath="Isin">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Isin, TargetNullValue=—}" ToolTip="{Binding IsinReinvestment, StringFormat=Reinvestment ISIN {0}}" Style="{StaticResource Cell.Mono}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Plan" Width="170" SortMemberPath="Option">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Border Style="{StaticResource Banner}" Tag="{x:Static ui:Tone.Accent}" Padding="7,1" Margin="0,0,6,0" CornerRadius="6"
                              Visibility="{Binding Plan, Converter={StaticResource VisibleWhenNull}, ConverterParameter=invert}">
                        <TextBlock Text="{Binding Plan, Converter={StaticResource ShortLabel}}" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource AccentBrush}" />
                      </Border>
                      <Border Style="{StaticResource Chip}" Padding="7,1" Margin="0" CornerRadius="6"
                              Visibility="{Binding Option, Converter={StaticResource VisibleWhenNull}, ConverterParameter=invert}">
                        <TextBlock Text="{Binding Option, Converter={StaticResource ShortLabel}}" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource TextMutedBrush}" />
                      </Border>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="NAV" Binding="{Binding Nav, StringFormat=N4}" Width="110"
                                  HeaderStyle="{StaticResource Header.Right}" ElementStyle="{StaticResource Cell.Number}" />
              <DataGridTextColumn Header="NAV date" Binding="{Binding NavDate, Converter={StaticResource LocalTime}}" SortMemberPath="NavDate" Width="120"
                                  HeaderStyle="{StaticResource Header.Right}" ElementStyle="{StaticResource Cell.NumberMuted}" />
              <DataGridTextColumn Header="Code" Binding="{Binding SchemeCode}" Width="90"
                                  HeaderStyle="{StaticResource Header.Right}" ElementStyle="{StaticResource Cell.NumberMuted}" />
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,40"
                      Visibility="{Binding Funds, Converter={StaticResource VisibleWhenEmpty}}">
            <Border Width="52" Height="52" CornerRadius="26" Background="{StaticResource FillSubtleBrush}" HorizontalAlignment="Center">
              <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE825;" FontSize="20" Foreground="{StaticResource TextSubtleBrush}" />
            </Border>
            <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Text.Muted}" TextAlignment="Center" Margin="0,12,0,0" MaxWidth="340" />
          </StackPanel>
        </Grid>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
