<UserControl x:Class="QuoteSnap.Desktop.Views.NavView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:QuoteSnap.Desktop.Controls"
             xmlns:vm="clr-namespace:QuoteSnap.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:NavViewModel}">
  <UserControl.Resources>
    <Style x:Key="Fact" TargetType="DockPanel">
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="Avatar" TargetType="Border">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- A fund on the user's list: avatar, name, "Growth · Equity · Large & Mid Cap", NAV and date; remove appears on hover. Drag a row to move it. -->
    <DataTemplate x:Key="MyFundTemplate" DataType="{x:Type vm:FundRow}">
      <Border x:Name="Row" Padding="20,12,12,12" Background="Transparent" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
              ToolTip="{Binding Details}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="96" />
            <ColumnDefinition Width="72" />
            <ColumnDefinition Width="96" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource Avatar}" Background="{Binding AvatarColor}">
            <TextBlock Text="{Binding Initials}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextOnAccentBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontSizeSection}" FontWeight="Medium" Foreground="{StaticResource TextBrush}"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineStackingStrategy="BlockLineHeight" LineHeight="19" MaxHeight="38"
                       ToolTip="{Binding Name}" />
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Muted}" Margin="0,3,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <StackPanel x:Name="NavBlock" Grid.Column="2" VerticalAlignment="Center">
            <TextBlock HorizontalAlignment="Right" FontSize="{StaticResource FontSizeSection}" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}" Typography.NumeralAlignment="Tabular">
              <Run Text="₹" Foreground="{StaticResource TextMutedBrush}" FontWeight="Normal" /><Run Text="{Binding NavText, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Text="{Binding NavDateText}" Style="{StaticResource Text.Muted}" HorizontalAlignment="Right" Margin="0,3,0,0"
                       FontSize="{StaticResource FontSizeCaption}" Typography.NumeralAlignment="Tabular" />
          </StackPanel>
          <TextBlock x:Name="MissingText" Grid.Column="2" Text="Not in AMFI file" Style="{StaticResource Text.Muted}" Foreground="{StaticResource WarningBrush}"
                     VerticalAlignment="Center" Visibility="Collapsed" />
          <ui:RollingText Grid.Column="3" Text="{Binding EstimateChangeText}" Key="{Binding SchemeCode, StringFormat=funds:{0}:change}" HorizontalAlignment="Right"
                          VerticalAlignment="Center" FontSize="{StaticResource FontSizeSection}" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"
                          Foreground="{Binding EstimateChangePercent, Converter={StaticResource SignBrush}}" ToolTip="{Binding EstimateTip}" />
          <StackPanel x:Name="EstimatedNav" Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="{Binding EstimateTip}"
                      TextElement.FontSize="{StaticResource FontSizeSection}" TextElement.FontWeight="SemiBold" Typography.NumeralAlignment="Tabular">
            <TextBlock Text="₹" Foreground="{StaticResource TextMutedBrush}" FontWeight="Normal" />
            <ui:RollingText Text="{Binding EstimatedNavText}" Key="{Binding SchemeCode, StringFormat=funds:{0}:nav}" Foreground="{StaticResource TextBrush}" />
          </StackPanel>
          <TextBlock x:Name="NoEstimatedNav" Grid.Column="4" Text="{Binding EstimatedNavText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                     FontSize="{StaticResource FontSizeSection}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" ToolTip="{Binding EstimateTip}"
                     Visibility="Collapsed" />
          <Button x:Name="RemoveButton" Grid.Column="5" Style="{StaticResource Button.Icon}" ui:Ui.Icon="&#xE711;" Margin="8,0,0,0" Opacity="0"
                  ToolTip="Remove from my funds" AutomationProperties.Name="Remove from my funds"
                  Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
          <Setter TargetName="Row" Property="Background" Value="{StaticResource HoverBrush}" />
          <Setter TargetName="RemoveButton" Property="Opacity" Value="1" />
        </Trigger>
        <Trigger SourceName="Row" Property="IsKeyboardFocusWithin" Value="True">
          <Setter TargetName="RemoveButton" Property="Opacity" Value="1" />
        </Trigger>
        <DataTrigger Binding="{Binding HasEstimatedNav}" Value="False">
          <Setter TargetName="EstimatedNav" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="NoEstimatedNav" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsMissing}" Value="True">
          <Setter TargetName="NavBlock" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="MissingText" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding DataContext.CanReorder, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
          <Setter TargetName="Row" Property="Cursor" Value="SizeAll" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsDragging}" Value="True">
          <Setter TargetName="Row" Property="Background" Value="{StaticResource HoverBrush}" />
          <Setter TargetName="Row" Property="Opacity" Value="0.6" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A search result: compact row with NAV and an Add button that turns into "Added". -->
    <DataTemplate x:Key="SearchResultTemplate" DataType="{x:Type vm:FundRow}">
      <Border x:Name="Row" Padding="10,9" CornerRadius="{StaticResource RadiusControl}" Background="Transparent" ToolTip="{Binding Details}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource Avatar}" Width="30" Height="30" CornerRadius="15" Background="{Binding AvatarColor}">
            <TextBlock Text="{Binding Initials}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextOnAccentBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" FontWeight="Medium" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
            <TextBlock Style="{StaticResource Text.Muted}" FontSize="{StaticResource FontSizeCaption}" Margin="0,2,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
              <Run Text="{Binding Subtitle, Mode=OneWay}" />
              <Run Text="·" Foreground="{StaticResource TextSubtleBrush}" />
              <Run Text="₹" /><Run Text="{Binding NavText, Mode=OneWay}" Foreground="{StaticResource TextBrush}" />
            </TextBlock>
          </StackPanel>
          <Button Grid.Column="2" Content="Add" ui:Ui.Icon="&#xE710;" Height="28" Padding="10,0" FontSize="{StaticResource FontSizeSmall}"
                  AutomationProperties.Name="Add to my funds" ToolTip="Add to my funds"
                  Visibility="{Binding IsAdded, Converter={StaticResource InverseBoolToVisibility}}"
                  Command="{Binding DataContext.AddCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0"
                      Visibility="{Binding IsAdded, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE73E;" FontSize="12" Foreground="{StaticResource SuccessBrush}" Margin="0,0,6,0" />
            <TextBlock Text="Added" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
          <Setter TargetName="Row" Property="Background" Value="{StaticResource HoverBrush}" />
        </Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Margin="{StaticResource PageMargin}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="320" />
    </Grid.RowDefinitions>

    <DockPanel Margin="0,0,0,22">
      <Button DockPanel.Dock="Right" Style="{StaticResource Button.DangerSolid}" ui:Ui.Icon="&#xE9D2;" VerticalAlignment="Center"
              Content="Get live prices" AutomationProperties.Name="Get live prices" Command="{Binding GetPricesCommand}"
              ui:Ui.IsSpinning="{Binding IsGettingPrices}"
              ToolTip="Gets the live prices of every stock your funds hold and estimates each fund's NAV for today from its holdings' weights." />
      <StackPanel Margin="0,0,24,0">
        <TextBlock Text="Mutual funds" Style="{StaticResource Text.PageTitle}" />
        <TextBlock Text="The latest NAVs of the Direct Plan funds you follow, and today's estimate from their holdings' live prices. Search by name to add a fund; your list is saved in the QuoteSnap service."
                   Style="{StaticResource Text.PageSubtitle}" TextWrapping="Wrap" />
      </StackPanel>
    </DockPanel>

    <Border Grid.Row="1" Style="{StaticResource Banner}" Tag="{Binding MessageLevel}" Margin="0,0,0,16"
            Visibility="{Binding Message, Converter={StaticResource VisibleWhenNull}, ConverterParameter=invert}">
      <DockPanel>
        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE946;" FontSize="14" Margin="0,1,10,0" VerticalAlignment="Top"
                   Foreground="{Binding MessageLevel, Converter={StaticResource ToneBrush}}" />
        <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Body}" />
      </DockPanel>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="420" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="400" />
      </Grid.ColumnDefinitions>

      <!-- My funds -->
      <Border Style="{StaticResource Card}" Padding="0">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="20,14,14,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Style="{StaticResource Button.Ghost}" Content="Original order" ui:Ui.Icon="&#xE8CB;" Margin="0,0,6,0" Height="32"
                      ToolTip="Show the funds in your own order" Command="{Binding ShowOriginalOrderCommand}"
                      Visibility="{Binding IsReordered, Converter={StaticResource BoolToVisibility}}" />
              <Button Style="{StaticResource Button.Icon}" ui:Ui.Icon="&#xE72C;" Margin="0,0,6,0" ToolTip="Reload the NAVs of your funds"
                      AutomationProperties.Name="Reload NAVs" Command="{Binding RefreshMyFundsCommand}"
                      ui:Ui.IsSpinning="{Binding RefreshMyFundsCommand.IsRunning}" />
              <Button Content="Export CSV" ui:Ui.Icon="&#xEDE1;" Command="{Binding ExportCommand}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="My funds" Style="{StaticResource Text.Section}" />
              <Border Style="{StaticResource Chip}" Margin="10,0,0,0" Padding="7,1" VerticalAlignment="Center">
                <TextBlock Text="{Binding MyFundsSummary}" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeCaption}" />
              </Border>
              <TextBlock Text="{Binding AsOfText}" Style="{StaticResource Text.Message}" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>
          </DockPanel>

          <TextBlock DockPanel.Dock="Top" Text="{Binding PricesText}" Style="{StaticResource Text.Message}" Margin="20,0,20,10"
                     Visibility="{Binding PricesText, Converter={StaticResource VisibleWhenNull}, ConverterParameter=invert}" />

          <Border DockPanel.Dock="Top" Style="{StaticResource Banner}" Tag="{x:Static vm:StatusLevel.Warning}" Margin="20,0,20,12"
                  Visibility="{Binding MyFundsError, Converter={StaticResource VisibleWhenNull}, ConverterParameter=invert}">
            <TextBlock Text="{Binding MyFundsError}" Style="{StaticResource Text.Body}" FontSize="{StaticResource FontSizeSmall}" />
          </Border>

          <DockPanel DockPanel.Dock="Top" Margin="70,0,64,8" Visibility="{Binding HasFunds, Converter={StaticResource BoolToVisibility}}">
            <TextBlock DockPanel.Dock="Right" Text="EST. NAV" Style="{StaticResource Text.Label}" Width="96" TextAlignment="Right"
                       ToolTip="The latest NAV moved by the estimated change" />
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Header}" Width="72" HorizontalContentAlignment="Right"
                    Command="{Binding SortByEstimateCommand}" AutomationProperties.Name="Sort by estimated change"
                    ToolTip="Today's estimated change: each holding's weight times its stock's day change; cash, bonds and holdings without a price count as unchanged. Click to sort: highest first, lowest first, then the original order.">
              <TextBlock Text="{Binding EstimateHeaderText}" Style="{StaticResource Text.Label}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
            <TextBlock DockPanel.Dock="Right" Text="NAV" Style="{StaticResource Text.Label}" Width="96" TextAlignment="Right" />
            <TextBlock Text="FUND" Style="{StaticResource Text.Label}" />
          </DockPanel>
          <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource DividerBrush}"
                  Visibility="{Binding HasFunds, Converter={StaticResource BoolToVisibility}}" />

          <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding MyFundsView}" ItemTemplate="{StaticResource MyFundTemplate}" Focusable="False"
                            AutomationProperties.Name="My funds" Margin="0,0,0,8" AllowDrop="True"
                            PreviewMouseLeftButtonDown="OnFundMouseDown" PreviewMouseMove="OnFundMouseMove" DragOver="OnFundDragOver" Drop="OnFundDrop" />
            </ScrollViewer>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,40" MaxWidth="360"
                        Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}">
              <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource AccentSubtleBrush}" HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE825;" FontSize="22" Foreground="{StaticResource AccentBrush}" />
              </Border>
              <TextBlock Text="Your list is empty" Style="{StaticResource Text.Section}" HorizontalAlignment="Center" Margin="0,14,0,0" />
              <TextBlock Text="Search for a fund on the right, such as “parag parikh flexi” or “nippon power infra”, then press Add."
                         Style="{StaticResource Text.Muted}" TextAlignment="Center" Margin="0,6,0,0" />
            </StackPanel>
          </Grid>
        </DockPanel>
      </Border>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" MinHeight="220" />
          <RowDefinition Height="16" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Search -->
        <Border Style="{StaticResource Card}" Padding="16,14,16,10">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="2,0,0,10">
              <TextBlock Text="Add funds" Style="{StaticResource Text.Section}" HorizontalAlignment="Left" />
              <TextBlock Text="Any part of the name works, in any order; small typos are fine." Style="{StaticResource Text.Muted}" Margin="0,2,0,0" />
            </StackPanel>

            <Grid DockPanel.Dock="Top">
              <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="34,9,34,9"
                       ui:Ui.Placeholder="Fund name, ISIN or scheme code" AutomationProperties.Name="Search funds">
                <TextBox.InputBindings>
                  <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
                </TextBox.InputBindings>
              </TextBox>
              <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE721;" FontSize="13" HorizontalAlignment="Left" Margin="13,0,0,0"
                         Foreground="{StaticResource TextSubtleBrush}" IsHitTestVisible="False" />
              <Button Style="{StaticResource Button.Icon}" ui:Ui.Icon="&#xE711;" Width="26" Height="26" HorizontalAlignment="Right" Margin="0,0,5,0"
                      ToolTip="Clear (Esc)" AutomationProperties.Name="Clear search" Command="{Binding ClearSearchCommand}"
                      Visibility="{Binding SearchText, Converter={StaticResource VisibleWhenNull}, ConverterParameter=invert}" />
            </Grid>

            <Grid DockPanel.Dock="Top" Height="3" Margin="2,6,2,4">
              <ProgressBar IsIndeterminate="True" Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <Border DockPanel.Dock="Top" Style="{StaticResource Banner}" Tag="{x:Static vm:StatusLevel.Warning}" Padding="10,6" Margin="0,2,0,6"
                    Visibility="{Binding SearchPartial, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="No fund matched every word; these are the closest." Style="{StaticResource Text.Body}" FontSize="{StaticResource FontSizeSmall}" />
            </Border>

            <Grid>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="-6,0,-6,0">
                <ItemsControl ItemsSource="{Binding SearchResults}" ItemTemplate="{StaticResource SearchResultTemplate}" Focusable="False"
                              AutomationProperties.Name="Search results" />
              </ScrollViewer>
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,24" MaxWidth="280"
                          Visibility="{Binding SearchResults, Converter={StaticResource VisibleWhenEmpty}}">
                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE721;" FontSize="22" Foreground="{StaticResource TextSubtleBrush}" />
                <TextBlock Text="{Binding SearchEmptyText}" Style="{StaticResource Text.Muted}" TextAlignment="Center" Margin="0,10,0,0" />
              </StackPanel>
            </Grid>
          </DockPanel>
        </Border>

        <!-- NAV cache status and refresh -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,14,16,16">
          <StackPanel>
            <DockPanel Margin="0,0,0,14">
              <ui:StatusPill DockPanel.Dock="Right" Text="{Binding StatusSummary}" Tone="{Binding StatusLevel, Converter={StaticResource Tone}}" />
              <ContentControl Style="{StaticResource IconBadge}" Tag="{Binding StatusLevel}" Content="&#xE825;" Width="32" Height="32" />
              <TextBlock Text="AMFI NAV file" Style="{StaticResource Text.Section}" Margin="12,0,0,0" />
            </DockPanel>
            <DockPanel Style="{StaticResource Fact}">
              <TextBlock DockPanel.Dock="Right" Text="{Binding SchemeCountText}" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
              <TextBlock Text="Direct Plan schemes" Style="{StaticResource Text.Muted}" />
            </DockPanel>
            <DockPanel Style="{StaticResource Fact}">
              <TextBlock DockPanel.Dock="Right" Text="{Binding LoadedAtText}" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
              <TextBlock Text="Downloaded" Style="{StaticResource Text.Muted}" />
            </DockPanel>
            <DockPanel Style="{StaticResource Fact}">
              <TextBlock DockPanel.Dock="Right" Text="{Binding LatestNavDateText}" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
              <TextBlock Text="Latest NAV date" Style="{StaticResource Text.Muted}" />
            </DockPanel>
            <TextBlock Text="{Binding StatusError}" Style="{StaticResource Text.Message}" Foreground="{StaticResource WarningBrush}" Margin="0,0,0,8"
                       MaxHeight="36" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusError}" />
            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,2,0,10"
                         Visibility="{Binding RefreshNavsCommand.IsRunning, Converter={StaticResource BoolToVisibility}}" />
            <Button Style="{StaticResource Button.Primary}" ui:Ui.Icon="&#xE896;" HorizontalAlignment="Stretch" Margin="0,4,0,0"
                    Command="{Binding RefreshNavsCommand}" ui:Ui.IsSpinning="{Binding RefreshNavsCommand.IsRunning}"
                    Content="Refresh NAVs" AutomationProperties.Name="Refresh NAVs"
                    ToolTip="Downloads AMFI's NAVAll.txt again (about 1.5 MB) and replaces the stored NAVs." />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
