# Local development: copy to .env and fill in. .env is gitignored; never commit real values.
# docker compose, the API (in Development) and the login tool all read it.

# Password for the local PostgreSQL. It is applied only when the database volume is first created.
QUOTESNAP_DB_PASSWORD=

ConnectionStrings__QuoteSnap=Host=127.0.0.1;Port=5432;Database=quotesnap;Username=quotesnap;Password=${QUOTESNAP_DB_PASSWORD}

# Random strings of at least 16 characters, e.g. from: openssl rand -hex 24
# X-Api-Key for /api calls, and X-Admin-Key for /admin calls (also used by the login tool).
Auth__ApiKey=
Auth__AdminApiKey=

# Optional: reject logins for any other Fyers account, e.g. XY12345
Fyers__ExpectedFyersId=

# Optional: the login tool asks for any of these that are missing.
Fyers__AppId=
Fyers__SecretId=
Fyers__Pin=
